#
# vendor/Pods/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

# Qwen Code tool artifacts (agent worktrees, sessions)
.qwen/
.enola/

# Agent tool state (settings, rules, worktrees) — local to each machine, not
# repository content. `.qwen/` and `.enola/` above are the same category.
.claude/
.cursor/
.review-state/

# Evaluation harness, minus local output. The harness is tracked on purpose: it is the
# thing that judges the agent, so a change to how a status is assigned, or to what
# adversity means, has to be reviewable and revertable in history — and its digest has
# to be able to tell two different corpora apart. Only run output stays ignored, so a
# clean checkout and `git status` stay meaningful.
agenteval/reports/
agenteval/tmp/
# Per-trial durable session stores. The adapter pins these here so a run never writes
# threads into the operator's live store; they are run output, not harness source.
agenteval/sessions/

# SQLite WAL sidecars from test runs (tracked fixture DBs opened by tests)
*.sqlite3-shm
*.sqlite3-wal
# benchmark_holdout always writes a leak scan; the holdout-pin keeps only
# manifest + truth.
documentation/benchmark/holdout-pin/leak-scan.json

# benchmark scenario driver runtime fixture
scenario/

# A runtime directory created inside the checkout (e.g. `tamoz telegram setup
# --runtime-dir .runtime-telegram`): operator state and a live database, never
# repository content.
.runtime-*/

# rubocop parallel-work cache
.rubocache/
.rubocop-cache/
