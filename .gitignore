*.gem
*.rbc
.DS_Store
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/
/.worktrees/
/.claude/worktrees/
/vendor/

# Used by dotenv library to load environment variables.
# Credentials must never be committable. Invariant 24 forbids secret values in
# durable records; the same rule applies to the repository itself.
.env
.env.*
!.env.example

# Ignore Byebug command history file.
.byebug_history

## Specific to RubyMotion:
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

## Specific to RubyMotion (use of CocoaPods):
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# vendor/Pods/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

# Qwen Code tool artifacts (agent worktrees, sessions)
.qwen/
.enola/

# Agent tool state (settings, rules, worktrees) — local to each machine, not
# repository content. `.qwen/` and `.enola/` above are the same category.
.claude/
.cursor/

# User-owned evaluation workspace. Not repository content; kept out of git so a
# clean checkout and `git status` stay meaningful.
agenteval/

# SQLite WAL sidecars from test runs (tracked fixture DBs opened by tests)
*.sqlite3-shm
*.sqlite3-wal
# benchmark_holdout always writes a leak scan; the holdout-pin keeps only
# manifest + truth (regenerated deliberately, see docs/new-design/impl/DOMAIN_LEAK_FIX.md)
documentation/benchmark/holdout-pin/leak-scan.json
