[
  {
    "name": "update_plan",
    "description": "Write or replace the whole plan. Call it first, and again whenever the plan changes. Changing the scope sends the plan back for review.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "done_when",
        "scope",
        "steps"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string"
          },
          "description": "Observable conditions, normally a configured check passing."
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string"
              },
              "description": "Workspace-relative file or directory prefixes the change may touch; no glob patterns."
            },
            "checks": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string"
              },
              "description": "Names of configured checks, exactly as run_check accepts them."
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "status"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "done"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 40
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruled_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "recall_output",
    "description": "Read a stored tool output by its locator (artifact:sha256:...), by line range or by a regular-expression filter.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        }
      }
    }
  }
]
