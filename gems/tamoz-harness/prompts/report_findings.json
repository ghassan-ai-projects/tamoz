{
  "name": "report_findings",
  "description": "Finish an investigation with a findings report. Every finding and proposal cites the ids of probe calls you made in this turn that succeeded. Proposals are for the operator; nothing in them is executed.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "hypothesis", "confidence", "findings", "gaps", "proposals"],
    "properties": {
      "summary": {"type": "string", "description": "What was asked and what the evidence shows, in two or three sentences."},
      "hypothesis": {"type": "string", "description": "The most likely explanation, or that the evidence cannot settle it."},
      "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
      "findings": {
        "type": "array", "minItems": 1, "maxItems": 20,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["statement", "evidence"],
          "properties": {
            "statement": {"type": "string"},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Ids of the probe calls this finding rests on."}
          }
        }
      },
      "gaps": {
        "type": "array", "maxItems": 20,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["datum", "why"],
          "properties": {"datum": {"type": "string"}, "why": {"type": "string"}}
        }
      },
      "proposals": {
        "type": "array", "maxItems": 10,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["action", "rationale", "evidence"],
          "properties": {
            "action": {"type": "string"},
            "rationale": {"type": "string"},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
