{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:situation-runtime:schema:decision:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "episode_id", "attempt_id", "fence", "snapshot_digest", "confidence", "intents"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "fence": {"type": "integer", "minimum": 1},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "situation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "situation_version": {"type": "integer", "minimum": 1},
    "primary_hypothesis": {"type": "string", "maxLength": 1024},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "maxLength": 4096},
    "facts_used": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "alternatives": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
    "intents": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}
