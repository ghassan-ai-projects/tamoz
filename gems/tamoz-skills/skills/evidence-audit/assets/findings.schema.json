{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence audit findings",
  "type": "object",
  "required": ["audit", "sources", "criteria", "findings"],
  "properties": {
    "audit": {
      "type": "object",
      "required": ["title", "criteria_source"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "criteria_source": { "type": "string", "minLength": 1 },
        "prepared_by": { "type": "string" },
        "prepared_at": { "type": "string" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" }
        }
      }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "text"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
      }
    },
    "findings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "title", "conclusion", "severity", "statement", "reasoning", "evidence", "review"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
          "criterion": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "conclusion": { "enum": ["exception", "no_exception", "insufficient_evidence"] },
          "severity": { "enum": ["high", "medium", "low", "info"] },
          "statement": { "type": "string", "minLength": 1 },
          "reasoning": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
          "counter_evidence": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
          "review": {
            "type": "object", "required": ["status", "reviewer", "decided_at"],
            "properties": {
              "status": { "enum": ["proposed", "accepted", "rejected", "needs_more_evidence"] },
              "reviewer": { "type": ["string", "null"] },
              "decided_at": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "review_log": { "type": "array" }
  },
  "$defs": {
    "citation": {
      "type": "object", "required": ["path", "lines", "quote", "supports"],
      "properties": {
        "path": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "quote": { "type": "string", "minLength": 20 },
        "supports": { "type": "string", "minLength": 1 }
      }
    }
  }
}
