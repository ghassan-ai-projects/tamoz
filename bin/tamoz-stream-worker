#!/usr/bin/env ruby
# frozen_string_literal: true

# The supervised episode worker launcher. P1: the production episode graph is
# THE fixed graph (Tamoz::Agent::EpisodeGraph) compiled in process — there is
# no --graph FILE on any production route. The launcher composes the ports:
# the Profile (model authority), the frame builder factory, the journaled
# model-call factory, and the deterministic decision builder (tamoz-stream).
#
#   tamoz-stream-worker \
#     --profile /etc/tamoz/worker-profile.yaml \
#     --database /var/lib/tamoz/worker.sqlite3 \
#     --tenant acme \
#     --socket /run/tamoz/worker.sock
#
# Production binds a UDS socket (mTLS at the socket boundary); development
# may pass --port instead.

$LOAD_PATH.unshift(*Dir[File.expand_path("../gems/*/lib", __dir__)])

require "optparse"
require "json"
# The umbrella establishes the dependency order (core defines Tamoz::Error,
# which stream/errors compiles against); subfiles alone would not.
require "tamoz/stream"
require "tamoz/stream/episode_worker"
require "tamoz/stream/worker_server"
require "tamoz/stream/verification_store"
require "tamoz/stream/artifact_store"
require "tamoz/stream/decision_node_builder"
require "tamoz/agent"
require "tamoz/sqlite"

options = {
  worker_version: "0.1.0.alpha.1",
  lane_config: "fast=flash,deep=pro,batch=flash",
  tenant: nil
}
parser = OptionParser.new do |opts|
  opts.on("--profile PATH", "Profile file carrying model_roles (the only model authority)") do |value|
    options[:profile] = value
  end
  opts.on("--database PATH", "SQLite database for the durable checkpointer") do |value|
    options[:database] = value
  end
  opts.on("--tenant TENANT", "Configured tenant for this worker") do |value|
    options[:tenant] = value
  end
  opts.on("--socket PATH", "UDS socket to bind (production; mTLS at the socket)") do |value|
    options[:socket] = value
  end
  opts.on("--port N", Integer, "TCP port to bind (development)") do |value|
    options[:port] = value
  end
  opts.on("--worker-version V", "Reported worker version") do |value|
    options[:worker_version] = value
  end
  opts.on("--lane-config SPEC", "lane=model triples, comma-separated") do |value|
    options[:lane_config] = value
  end
  opts.on("--skills-source PATH", "JSON map {name => rendered text} of the operator-approved skills") do |value|
    options[:skills_source] = value
  end
end
parser.on("--runtime-dir PATH", "Operator runtime directory whose sources.probes the episodes may use") do |value|
  options[:runtime_dir] = value
end
parser.parse!(ARGV)

unless options[:profile] && options[:database] && options[:tenant]
  warn parser
  exit 2
end

lane_config = Tamoz::Agent::LaneConfig.build(
  options[:lane_config].split(",").to_h do |pair|
    lane, model = pair.split("=", 2)
    raise ArgumentError, "malformed lane config: #{pair}" if lane.nil? || model.nil?

    [lane.strip, model.strip]
  end
)

# The Profile is the sole model authority: the wire names a role, the intake
# node resolves it here (fail-closed) before any model call. Validation-only
# load — no adoption ceremony for operator config.
profile = Tamoz::Agent::Profile.preview(options.fetch(:profile))

checkpointer = Tamoz::SQLite::Adapter.new(
  path: options.fetch(:database), state_codec: Tamoz::Agent::Memory::Surface.codec
)
memory = Tamoz::Agent::Memory::Engine.new(
  tenant: options.fetch(:tenant), adapter: checkpointer
)
recaller = Tamoz::Agent::Memory::SituationRecaller.new(engine: memory)
caller = memory.caller(
  user: "stream", project: "stream", sensitivity: :internal,
  compatibility: {graph_version: "1", behavior_version: Tamoz::Agent::BEHAVIOR_VERSION}
)
# P5: the operator-approved skill source — a JSON map {name => rendered
# text}; when unset, ANY episode requesting a skill ref fails closed at
# build_frame (the production compiler seam is Tamoz::Tools::Skills over the
# operator directory; its Snapshot records map to this map).
skills_source = JSON.parse(File.read(options.fetch(:skills_source))) if options.key?(:skills_source)
nodes = Tamoz::Agent::EpisodeNodes.new(
  profile:,
  frame_builder_factory: lambda do |catalog, objective|
    Tamoz::Agent::EpisodeFrameBuilder.new(catalog:, objective:)
  end,
  model_call_factory: lambda do |role|
    resolved_role = Tamoz::Agent::ModelCall.resolve_role(profile, role.fetch("name"))
    transport = Tamoz::Agent::ModelClientFactory.build(
      provider: resolved_role.provider,
      model: resolved_role.model,
      profile_role: resolved_role,
      environment: ENV,
      explicit_api_base: role.fetch("endpoint").to_s.empty? ? nil : role.fetch("endpoint")
    )
    Tamoz::Agent::EpisodeModelCall.new(transport:)
  end,
  decision_builder: Tamoz::Stream::DecisionNodeBuilder.new,
  skills_source: skills_source || {},
  situation_recaller: recaller,
  recall_caller: caller
)
app = Tamoz::Agent::EpisodeGraph.build(checkpointer:, nodes:)
worker = Tamoz::Stream::EpisodeWorker.new(
  worker_version: options[:worker_version],
  lane_config:
)
# The operator's MCP servers, narrowed to its read-only probes; only probe_* names reach an episode.
mcp_source = nil
if options[:runtime_dir]
  begin
    directory = Tamoz::Agent::RuntimeDirectory.resolve(path: options[:runtime_dir])
    mcp_source = Tamoz::Agent::McpSourceBuilder.new(directory).build
  rescue Tamoz::Error => e
    warn "tamoz-stream-worker: #{e.message}"
    exit 2
  end
  unless mcp_source.is_a?(Tamoz::Agent::ProbeSource)
    mcp_source&.close
    warn "tamoz-stream-worker: --runtime-dir #{options[:runtime_dir]} enables no sources.probes"
    exit 2
  end
end
runner = Tamoz::Stream::EpisodeRunner.new(
  durable_runner: app.durable_runner,
  worker:,
  verification_store: checkpointer.bind_verification_store,
  artifact_store: Tamoz::Stream::ArtifactStore.new,
  configured_tenant: options.fetch(:tenant),
  probe_source: mcp_source
)
worker.bind_runner(runner)

server = Tamoz::Stream::WorkerServer.new(
  worker:,
  socket: options[:socket],
  port: options[:port]
)
# grpc's stop takes a mutex, which a trap handler may not; stopping from a thread lets run return and
# the MCP supervisors close.
%w[TERM INT].each { |signal| trap(signal) { Thread.new { server.stop } } }
begin
  server.run
ensure
  mcp_source&.close
end
