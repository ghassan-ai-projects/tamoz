#!/usr/bin/env ruby
# frozen_string_literal: true

# E2E launcher: the normal EpisodeWorker/WorkerServer plus Channel B learning.
# It intentionally lives beside the tracked launcher until the live runbook
# proves the composition; the worker launcher itself remains unchanged.

$LOAD_PATH.unshift(*Dir[File.expand_path('../gems/*/lib', __dir__)])

require 'digest'
require 'fileutils'
require 'logger'
require 'optparse'

require 'tamoz/stream/episode_worker'
require 'tamoz/stream/sse_transport'
require 'tamoz/stream/worker_server'
require 'tamoz/stream/verification_store'
require 'tamoz/stream/situation_memory'
require 'tamoz/stream/artifact_store'
require 'tamoz/agent'
require 'tamoz/sqlite'

# SQLite-backed subscriber cursor and admission fence.
class DurableSubscriberStore
  NAMESPACE = 'tamoz.stream.subscriber'

  def initialize(adapter)
    @store = adapter.store
  end

  def read
    value('cursor')&.fetch('cursor')
  end

  def write(cursor)
    put('cursor', { 'cursor' => cursor })
  end

  def admitted?(intent_id)
    !value(admission_key(intent_id)).nil?
  end

  def mark_admitted(intent_id)
    key = admission_key(intent_id)
    return if admitted?(intent_id)

    put(key, { 'intent_id' => intent_id })
  end

  private

  def value(key)
    entry = @store.get(NAMESPACE, key)
    entry&.value
  end

  def put(key, value)
    version = @store.head_version(NAMESPACE, key)
    @store.put(NAMESPACE, key, value, if_version: version)
  end

  def admission_key(intent_id)
    "admitted/#{Digest::SHA256.hexdigest(intent_id)}"
  end
end

# Channel B handlers that close verification and admit Experiences.
# rubocop:disable Style/OneClassPerFile -- this untracked E2E launcher keeps its two composition helpers together.
class LiveLearningHandlers
  RECORDED = 'io.agenticstream.outcome.recorded.v1'
  RECONCILED = 'io.agenticstream.outcome.reconciled.v1'

  def initialize(verification:, memory:, durable:, logger:)
    @verification = verification
    @memory = memory
    @durable = durable
    @logger = logger
  end

  def callables
    { RECORDED => method(:record_outcome), RECONCILED => method(:reconcile_outcome) }
  end

  private

  def record_outcome(event)
    data = event.data
    @verification.record_outcome(
      intent_id: data.fetch('intent_id'),
      outcome_id: data.fetch('outcome_id'),
      outcome_digest: data.fetch('outcome_digest'),
      command_id: data['command_id']
    )
    @logger.info("outcome recorded intent=#{data.fetch('intent_id')}")
  end

  def reconcile_outcome(event)
    data = event.data
    intent_id = data.fetch('intent_id')
    reconcile(data, intent_id)
    row = @verification.fetch(intent_id:)
    return log_unlearnable(intent_id) unless row.learnable?
    return log_duplicate(intent_id) if @durable.admitted?(intent_id)

    admit_experience(row, data, event, intent_id)
  rescue Tamoz::StoreConflictError
    @durable.mark_admitted(intent_id)
    log_duplicate(intent_id)
  end

  def reconcile(data, intent_id)
    @verification.reconcile(
      intent_id:,
      verdict: data.fetch('verdict'),
      reconciliation_version: data.fetch('reconciliation_version'),
      source_authority: data.fetch('source_authority')
    )
  end

  def admit_experience(row, data, event, intent_id)
    result = @memory.admission.admit_episode(**admission_attributes(row, data, event, intent_id))
    unless result.accepted?
      return handle_duplicate_admission(intent_id) if result.reason == 'duplicate_identity'

      raise "experience admission rejected: #{result.reason}"
    end

    @durable.mark_admitted(intent_id)
    @logger.info(
      "experience admitted intent=#{intent_id} memory_id=#{result.record.memory_id} " \
      "epistemic_kind=#{result.record.epistemic_kind}"
    )
  end

  def admission_attributes(row, data, event, intent_id)
    {
      episode: row.episode.merge(observed_outcome: observed_outcome(data)),
      owner: 'stream',
      reconciled_outcome: @verification.reference(intent_id:),
      verify_source_authority: ->(reference) { reference.fetch('source_authority') == event.source }
    }
  end

  def handle_duplicate_admission(intent_id)
    @durable.mark_admitted(intent_id)
    log_duplicate(intent_id)
  end

  def observed_outcome(data)
    {
      'outcome' => data.fetch('outcome', 'reconciled outcome'),
      'confidence' => data.fetch('confidence', 0.9)
    }
  end

  def log_unlearnable(intent_id)
    @logger.info("outcome reconciled but not learnable intent=#{intent_id}")
  end

  def log_duplicate(intent_id)
    @logger.info("experience already admitted intent=#{intent_id}")
  end
end
# rubocop:enable Style/OneClassPerFile

default_log = File.expand_path('../../.e2e-run/subscriber.log', __dir__)
options = {
  worker_version: '0.1.0.alpha.1',
  lane_config: 'fast=flash,deep=pro,batch=flash',
  events_url: 'http://127.0.0.1:8080/v1/events',
  subscriber_log: default_log
}
parser = OptionParser.new do |opts|
  opts.on('--graph FILE', 'Ruby file defining build_episode_app(checkpointer)') { |value| options[:graph] = value }
  opts.on('--database PATH', 'SQLite database for the durable checkpointer') { |value| options[:database] = value }
  opts.on('--socket PATH', 'UDS socket to bind') { |value| options[:socket] = value }
  opts.on('--port N', Integer, 'TCP port to bind') { |value| options[:port] = value }
  opts.on('--worker-version V', 'Reported worker version') { |value| options[:worker_version] = value }
  opts.on('--lane-config SPEC', 'lane=model triples, comma-separated') { |value| options[:lane_config] = value }
  opts.on('--events-url URL', 'SSE notification feed') { |value| options[:events_url] = value }
  opts.on('--subscriber-database PATH', 'SQLite database for the cursor and admission fence') do |value|
    options[:subscriber_database] = value
  end
  opts.on('--memory-database PATH', 'SQLite database for admitted Experiences') do |value|
    options[:memory_database] = value
  end
  opts.on('--subscriber-log PATH', 'Subscriber activity log') { |value| options[:subscriber_log] = value }
end
parser.parse!(ARGV)

unless options[:graph] && options[:database]
  warn parser
  exit 2
end

credential = ENV.fetch('AGENTIC_STREAM_SUBSCRIBER_TOKEN', nil)
if credential.to_s.empty?
  warn 'AGENTIC_STREAM_SUBSCRIBER_TOKEN is required'
  exit 2
end

options[:subscriber_database] ||= "#{options.fetch(:database)}.subscriber.sqlite3"
options[:memory_database] ||= "#{options.fetch(:database)}.memory.sqlite3"
FileUtils.mkdir_p(File.dirname(options.fetch(:subscriber_log)))
logger = Logger.new(options.fetch(:subscriber_log))

lane_config = Tamoz::Agent::LaneConfig.build(
  options[:lane_config].split(',').to_h do |pair|
    lane, model = pair.split('=', 2)
    raise ArgumentError, "malformed lane config: #{pair}" if lane.nil? || model.nil?

    [lane.strip, model.strip]
  end
)

require File.expand_path(options.fetch(:graph))

checkpointer = Tamoz::SQLite::Adapter.new(path: options.fetch(:database))
subscriber_adapter = Tamoz::SQLite::Adapter.new(path: options.fetch(:subscriber_database))
memory_adapter = Tamoz::SQLite::Adapter.new(
  path: options.fetch(:memory_database),
  state_codec: Tamoz::Agent::Memory::Surface.codec
)
app = build_episode_app(checkpointer)
verification = Tamoz::Stream::VerificationStore.new
runner = Tamoz::Stream::EpisodeRunner.new(
  durable_runner: app.durable_runner,
  worker: nil,
  verification_store: verification,
  artifact_store: Tamoz::Stream::ArtifactStore.new
)
worker = Tamoz::Stream::EpisodeWorker.new(
  worker_version: options.fetch(:worker_version),
  runner:,
  lane_config:
)
server = Tamoz::Stream::WorkerServer.new(
  worker:,
  socket: options[:socket],
  port: options[:port]
)
durable = DurableSubscriberStore.new(subscriber_adapter)
memory = Tamoz::Agent::Memory::Engine.new(
  tenant: 'acme', adapter: memory_adapter, protection: nil
)
handlers = LiveLearningHandlers.new(
  verification:, memory:, durable:, logger:
)
subscriber = Tamoz::Stream::OutcomeSubscriber.new(
  cursor_store: durable,
  handlers: handlers.callables,
  credential:
)
transport = Tamoz::Stream::SseTransport.new(
  endpoint: options.fetch(:events_url), logger:
)
stopping = false
stop = lambda do
  stopping = true
  transport.stop
  server.stop
end
trap('TERM') { stop.call }
trap('INT') { stop.call }

subscriber_thread = Thread.new do
  until stopping
    begin
      subscriber.run(transport:)
    rescue StandardError => e
      logger.error("subscriber error=#{e.class}: #{e.message}")
      sleep(1) unless stopping
    end
  end
end
logger.info("subscriber started endpoint=#{options.fetch(:events_url)}")

begin
  server.run
ensure
  stop.call
  subscriber_thread.join(5)
  checkpointer.close
  subscriber_adapter.close
  memory_adapter.close
  logger.info('subscriber stopped')
  logger.close
end
