#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(*Dir[File.expand_path('../gems/*/lib', __dir__)])

require 'json'
require 'optparse'
require 'tamoz/evals'

options = { publish: false, artifact_base: Dir.pwd }
OptionParser.new do |parser|
  parser.banner = 'Usage: script/benchmark_openclaw_readiness --protocol PATH --manifest PATH [--publish]'
  parser.on('--protocol PATH') { |value| options[:protocol] = value }
  parser.on('--manifest PATH') { |value| options[:manifest] = value }
  parser.on('--missions PATH') { |value| options[:missions] = value }
  parser.on('--artifact-base PATH') { |value| options[:artifact_base] = value }
  parser.on('--publish') { options[:publish] = true }
end.parse!

missing = %i[protocol manifest missions].reject { |key| options.key?(key) }
abort "missing required options: #{missing.join(', ')}" unless missing.empty?

protocol = JSON.parse(File.read(options.fetch(:protocol), encoding: Encoding::UTF_8))
manifest = JSON.parse(File.read(options.fetch(:manifest), encoding: Encoding::UTF_8))
mission_catalog = JSON.parse(File.read(options.fetch(:missions), encoding: Encoding::UTF_8))
mission_ids = mission_catalog.fetch('missions').map { |mission| mission.fetch('id') }
result = Tamoz::Evals::Benchmark::Readiness.evaluate(
  protocol:, manifest:, expected_mission_ids: mission_ids, mission_catalog:,
  artifact_root_base: options.fetch(:artifact_base)
)
puts JSON.pretty_generate(result.to_h.merge('protocol_version' => protocol.fetch('benchmark_protocol_version')))

if options.fetch(:publish) && !result.publishable?
  warn "benchmark publication refused: #{result.reasons.join(', ')}"
  exit 2
end
