#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(*Dir[File.expand_path('../gems/*/lib', __dir__)])

require 'json'
require 'optparse'
require 'tamoz/evals'

root = File.expand_path('..', __dir__)
options = { artifact_base: Dir.pwd }
OptionParser.new do |parser|
  parser.banner = 'Usage: script/benchmark_openclaw_cells --manifest PATH ' \
                  '--report-out PATH --artifact-base DIR'
  parser.on('--manifest PATH') { |value| options[:manifest] = value }
  parser.on('--report-out PATH') { |value| options[:report_out] = value }
  parser.on('--artifact-base DIR') { |value| options[:artifact_base] = value }
end.parse!

missing = %i[manifest report_out].reject { |key| options.key?(key) }
abort "missing required options: #{missing.join(', ')}" unless missing.empty?

read_json = lambda do |path|
  JSON.parse(File.read(path, encoding: Encoding::UTF_8))
end

begin
  manifest = read_json.call(options.fetch(:manifest))
  protocol = read_json.call(File.join(root, 'documentation', 'benchmark', 'BENCHMARK_PROTOCOL.json'))
  Tamoz::Evals::Benchmark::ComparisonExecutor.new(
    manifest:, protocol:, artifact_base: options.fetch(:artifact_base)
  ).write(options.fetch(:report_out))
rescue JSON::ParserError => e
  warn "benchmark cells refused: invalid JSON: #{e.message}"
  exit 2
rescue ArgumentError, KeyError, Errno::ENOENT, Tamoz::Evals::Error => e
  warn "benchmark cells refused: #{e.message}"
  exit 2
end
