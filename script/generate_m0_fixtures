generated_cases = specifications.each_with_index.map do |specification, index|
  document = golden_case(index: index + 1, **specification)
  filename = format("%02d_%s.case.json", index + 1, specification.fetch(:id).delete_prefix("m0.").tr(".", "_"))
  write_artifact(File.join(case_root, filename), document, domain: "eval.case")
end

summary_path = File.join(evidence_root, "baseline-summary.json")
summary = {
  "format_version" => 1,
  "note" => "M0 defines evaluation contracts before runtime behavior.",
  "status" => "insufficient_evidence"
}
File.write(
  summary_path,
  "#{Tamoz::Evals::CanonicalJSON.dump(summary)}\n",
  encoding: Encoding::UTF_8
)

suite_digest = Tamoz::Evals::CanonicalJSON.content_digest(
  {
    "suite_id" => "tamoz.m0.golden",
    "case_digests" => generated_cases.map { |document| document.fetch("content_digest") }
  },
  domain: "eval.suite"
)
subject_digest = Tamoz::Evals::CanonicalJSON.content_digest(
  {"subject_id" => "tamoz-agent", "version" => "0.1.0.alpha.1"},
  domain: "eval.subject"
)
