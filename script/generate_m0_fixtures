#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"

Dir[File.expand_path("../gems/*/lib", __dir__)].sort.each do |path|
  $LOAD_PATH.unshift(path)
end
require "tamoz/evals"

root = ENV.fetch(
  "TAMOZ_FIXTURE_ROOT",
  File.expand_path("../gems/tamoz-evals", __dir__)
)
case_root = File.join(root, "suites", "m0", "golden")
baseline_root = File.join(root, "baselines", "m0")
evidence_root = File.join(baseline_root, "evidence")
[case_root, evidence_root].each { |path| FileUtils.mkdir_p(path) }

def write_artifact(path, document, domain:)
  document["content_digest"] = Tamoz::Evals::CanonicalJSON.content_digest(document, domain:)
  canonical = Tamoz::Evals::CanonicalJSON.normalize(document)
  File.write(
    path,
    "#{Tamoz::Evals::CanonicalJSON.dump(canonical)}\n",
    encoding: Encoding::UTF_8
  )
  canonical
end

def golden_case(index:, id:, title:, purpose:, tags:, risk:, input:, allowed:, prohibited:,
                done:, evidence:)
  {
    "artifact_type" => "case",
    "format_version" => 1,
    "digest_version" => 1,
    "content_digest" => "pending",
    "case_id" => id,
    "case_version" => 1,
    "suite_id" => "tamoz.m0.golden",
    "split" => tags.include?("adversarial") ? "adversarial" : "conformance",
    "title" => title,
    "purpose" => purpose,
    "tags" => tags,
    "risk_class" => risk,
    "input" => {
      "kind" => "contract-scenario",
      "payload" => input
    },
    "environment" => {
      "profile" => "pr",
      "isolation" => "subprocess",
      "network" => "denied"
    },
    "capabilities" => {
      "allowed" => allowed,
      "prohibited" => prohibited
    },
    "definition_of_done" => done,
    "evidence" => {
      "required" => evidence.map.with_index do |(kind, oracle), evidence_index|
        {
          "id" => format("evidence.%02d.%02d", index, evidence_index + 1),
          "kind" => kind,
          "oracle" => oracle
        }
      end,
      "optional" => []
    },
    "scorers" => [
      {
        "id" => "tamoz.m0.contract",
        "kind" => "deterministic",
        "version" => "v1"
      }
    ],
    "budgets" => {
      "turns" => 1,
      "steps" => 20,
      "tool_calls" => 20,
      "tokens" => 0,
      "cost_microusd" => 0,
      "time_ms" => 30_000
    },
    "repetitions" => {
      "count" => 1,
      "comparison_method" => "exact"
    },
    "content_policy" => {
      "classification" => "public",
      "capture" => "metadata"
    },
    "references" => []
  }
end

