#!/usr/bin/env ruby
# frozen_string_literal: true

# Telegram chat eval: the real gateway and worker processes, a real model
# provider, and a fake Bot API standing in for Telegram. See
# test/support/telegram_chat_eval.rb.
#
#   bundle exec ruby script/telegram_chat_eval [--only greet,memory] [--routing experimental]
#
# Provider: TAMOZ_PROVIDER / TAMOZ_MODEL (default openrouter, deepseek/deepseek-v4.1-flash); routing: work;
# the key comes from the environment or .env. Report: tmp/telegram-eval/<stamp>/.

require 'bundler/setup'
require 'optparse'

# The gateway child: the real CLI, with only the Bot API origin swapped for the fake's.
if ARGV.first == '--gateway'
  ARGV.shift
  origin = ARGV.shift
  require 'tamoz/agent_cli'
  require 'tamoz/telegram'
  exit Tamoz::Agent::CLI.run(ARGV, comms_client_factory: ->(token) { Tamoz::Telegram::Client.new(token, origin:) })
end

$LOAD_PATH.unshift(File.expand_path('../test/support', __dir__))
require 'tamoz/agent'
require 'telegram_chat_eval'
require 'telegram_chat_scenarios'

options = { provider: ENV.fetch('TAMOZ_PROVIDER', 'openrouter'),
            model: ENV.fetch('TAMOZ_MODEL', 'deepseek/deepseek-v4.1-flash'),
            routing: 'work', only: TelegramChatScenarios.all }
OptionParser.new do |parser|
  parser.on('--only LIST') { |list| options[:only] = list.split(',') }
  parser.on('--routing NAME', TelegramChatEval::ROUTING_FLAGS.keys + ['legacy']) { |name| options[:routing] = name }
  parser.on('--provider NAME') { |name| options[:provider] = name }
  parser.on('--model NAME') { |name| options[:model] = name }
end.parse!

evaluation = TelegramChatEval.new(**options.slice(:provider, :model, :routing))
puts "telegram chat eval — #{evaluation.label}"
begin
  evaluation.start
  (TelegramChatScenarios.all & options[:only]).each do |name|
    print "  #{name} … "
    started = Time.now
    begin
      TelegramChatScenarios.public_send(name, evaluation)
    rescue TelegramChatEval::ProcessDied => e
      evaluation.check(name, 'scenario ran', false, e.message)
      break
    rescue StandardError => e
      evaluation.check(name, 'scenario ran', false, "#{e.class}: #{e.message}")
    end
    puts format('%.0fs', Time.now - started)
  end
ensure
  evaluation.shutdown
end

directory = File.expand_path("../tmp/telegram-eval/#{Time.now.strftime('%Y%m%d-%H%M%S')}", __dir__)
evaluation.write_report(directory)
results = evaluation.results
results.reject { |result| result[:pass] }.each do |result|
  puts "  FAIL #{result[:scenario]}: #{result[:check]} — #{result[:detail].to_s[0, 110]}"
end
passed = results.count { |result| result[:pass] }
puts "\n#{passed}/#{results.length} checks pass — #{directory}/report.md"
exit(passed == results.length ? 0 : 1)
