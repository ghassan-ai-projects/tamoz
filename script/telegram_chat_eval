#!/usr/bin/env ruby
# frozen_string_literal: true

# Telegram chat eval: the real `tamoz setup`, `channel add telegram` and `start`, a real model
# provider, and a stand-in Bot API for Telegram's servers. See test/support/telegram_chat_eval.rb.
#
#   bundle exec ruby script/telegram_chat_eval [--only greet,memory] [--runtime-from ~/.tamoz]
#                                             [--provider NAME --model NAME]
#
# Keys come from the environment or .env; the chat model is --provider/--model (default
# openrouter/deepseek/deepseek-v4.1-flash). --runtime-from copies a lived-in runtime (history,
# profiles, sources) and runs on the copy.
# Report: tmp/telegram-eval/<stamp>/.

require 'bundler/setup'
require 'optparse'

$LOAD_PATH.unshift(File.expand_path('../test/support', __dir__))
require 'tamoz/agent'
require 'telegram_chat_eval'
require 'telegram_chat_scenarios'

options = { provider: ENV.fetch('AGENTEVAL_PROVIDER', nil), model: ENV.fetch('AGENTEVAL_MODEL', nil),
            runtime_from: nil, only: TelegramChatScenarios.all }
OptionParser.new do |parser|
  parser.on('--only LIST') { |list| options[:only] = list.split(',') }
  parser.on('--runtime-from PATH') { |path| options[:runtime_from] = path }
  parser.on('--provider NAME') { |name| options[:provider] = name }
  parser.on('--model NAME') { |name| options[:model] = name }
end.parse!

directory = File.expand_path("../tmp/telegram-eval/#{Time.now.strftime('%Y%m%d-%H%M%S')}", __dir__)
evaluation = TelegramChatEval.run(report_to: directory, **options.slice(:provider, :model, :runtime_from)) do |run|
  begin
    run.start
  rescue StandardError => e
    run.check('start', 'tamoz start runs the bot', false, "#{e.class}: #{e.message}")
    options[:only] = []
  end
  puts "telegram chat eval — #{run.label}"
  (TelegramChatScenarios.all & options[:only]).each do |name|
    print "  #{name} … "
    started = Time.now
    begin
      TelegramChatScenarios.public_send(name, run)
    rescue TelegramChatEval::ProcessDied => e
      run.check(name, 'scenario ran', false, e.message)
      break
    rescue StandardError => e
      run.check(name, 'scenario ran', false, "#{e.class}: #{e.message}")
    end
    puts format('%.0fs', Time.now - started)
  end
end
results = evaluation.results
results.select { |result| result[:pass].nil? }.each do |result|
  puts "  BLOCKED #{result[:scenario]}: #{result[:detail]}"
end
results.select { |result| result[:pass] == false }.each do |result|
  puts "  FAIL #{result[:scenario]}: #{result[:check]} — #{result[:detail].to_s[0, 110]}"
end
passed = results.count { |result| result[:pass] }
graded = results.reject { |result| result[:pass].nil? }
puts "\n#{passed}/#{graded.length} checks pass, #{results.length - graded.length} blocked — #{directory}/report.md"
exit(if passed != graded.length then 1
     elsif graded.length < results.length || graded.empty? then 2
     else 0
     end)
