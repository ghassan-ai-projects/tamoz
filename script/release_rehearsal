#!/usr/bin/env ruby
# frozen_string_literal: true

# P15-H (docs/P15_RELEASE_PLAN.md §10, correction 4) — the release rehearsal.
#
# The point is NOT to run the gate again. The point is to run it somewhere that
# is not the development checkout, with a toolchain that is pinned rather than
# whatever the developer happens to have loaded, because a rehearsal that can
# only pass on the machine that built it proves nothing about a release.
#
# Steps, each recorded with its outcome and duration:
#
#   1. provisioning     the running Ruby matches `.ruby-version` and bundler
#                       matches the lockfile's `BUNDLED WITH` — a dev-machine
#                       rehearsal can pass while a user on another patch level
#                       fails, so provisioning is part of the script
#   2. clean clone      `git clone` of the candidate commit into a temp dir,
#                       with the source worktree verified clean first
#   3. dependencies     `bundle install --local` inside the clone
#   4. full gate        `rake ci` under BOTH `LC_ALL=C` and `LC_ALL=en_US.UTF-8`
#   5. scorecard        `tamoz-eval scorecard agent-smoke`, with the decision,
#                       the four hard gates and the hard-zero safety counters
#                       asserted, and the content digest recorded
#   6. packaged gems    each gem built, installed into its own GEM_HOME and
#                       exercised by its example task (`packaging_test`) — the
#                       workspace Gemfile resolves every gem via `path:`, which
#                       masks gemspec dependency errors, so this is the only
#                       place they can surface
#   7. durable restore  the acceptance workflow (kill + resume + verification)
#                       and the SQLite backup/restore suite, run by name in the
#                       clone so the log names them
#   8. requirements     the P15-A audit, recorded but NOT gating: its remaining
#                       release-blocking gaps are the owner's decision at P15-I,
#                       not something a rehearsal may wave through
#
# Evidence: `docs/RELEASE_REHEARSAL.md` and `docs/release-rehearsal.json`,
# written into the SOURCE repository (never the clone) and committed.
#
# Usage:
#   script/release_rehearsal              # rehearse HEAD, write the evidence
#   script/release_rehearsal --keep       # keep the clone for inspection

require "json"
require "open3"
require "rbconfig"
require "time"
require "tmpdir"
require "fileutils"

ROOT = File.expand_path("..", __dir__)

# The steps this rehearsal performs, declared once. The run asserts that the
# steps it actually recorded equal this list, so a step that stops running —
# or one added without declaring it — fails the rehearsal instead of quietly
# shrinking what a release candidate was checked against.
STEP_NAMES = %w[
  provisioning clean-clone bundle-install gate-lc-c gate-lc-utf8
  gate-locale-agreement scorecard packaged-gem-isolation durable-kill-resume
  backup-restore session-operations release-evaluation-pin benchmark
  requirements-audit
].freeze
LOG_JSON = File.join(ROOT, "docs", "release-rehearsal.json")
LOG_MD = File.join(ROOT, "docs", "RELEASE_REHEARSAL.md")
UTF8_LOCALE = "en_US.UTF-8"

def read_utf8(path) = File.read(path, encoding: Encoding::UTF_8)

steps = []
failures = []

def record(steps, failures, name, detail: nil)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  ok, note = yield
  duration = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(2)
  steps << {"step" => name, "ok" => ok, "seconds" => duration, "note" => note || detail}
  failures << "#{name}: #{note}" unless ok
  print(ok ? "." : "x")
  $stdout.flush
  ok
end

def run(command, chdir:, env: {})
  stdout, stderr, status = Open3.capture3(env, *command, chdir:)
  [status.success?, stdout, stderr, status]
end

# --- 1. provisioning ---------------------------------------------------------

expected_ruby = read_utf8(File.join(ROOT, ".ruby-version")).strip
expected_bundler = read_utf8(File.join(ROOT, "Gemfile.lock"))[/BUNDLED WITH\s*\n\s*(\S+)/, 1]
running_bundler = Open3.capture2(RbConfig.ruby, "-S", "bundle", "--version").first[/[\d.]+/]

record(steps, failures, "provisioning") do
  problems = []
  unless RUBY_VERSION == expected_ruby
    problems << "ruby #{RUBY_VERSION} != pinned #{expected_ruby}"
  end
  unless running_bundler == expected_bundler
    problems << "bundler #{running_bundler} != lockfile #{expected_bundler}"
  end
  [problems.empty?,
   problems.empty? ? "ruby #{RUBY_VERSION}, bundler #{running_bundler}" : problems.join("; ")]
end

# --- 2. clean clone ----------------------------------------------------------

candidate = Open3.capture2("git", "-C", ROOT, "rev-parse", "HEAD").first.strip
# `agenteval/` is user-owned and untracked; it is not part of the candidate and
# is deliberately excluded from the cleanliness check.
dirty = Open3.capture2("git", "-C", ROOT, "status", "--porcelain").first
       .lines.reject { |line| line.include?("agenteval/") }.join

keep = ARGV.include?("--keep")
workdir = Dir.mktmpdir("tamoz-rehearsal")
clone = File.join(workdir, "tamoz")

record(steps, failures, "clean-clone", detail: candidate) do
  if dirty.empty?
    ok, _out, stderr, = run(["git", "clone", "--quiet", "--local", ROOT, clone], chdir: workdir)
    if ok
      cloned = Open3.capture2("git", "-C", clone, "rev-parse", "HEAD").first.strip
      ok = cloned == candidate
      [ok, ok ? "cloned #{candidate[0, 12]}" : "clone is at #{cloned}, expected #{candidate}"]
    else
      [false, stderr.lines.last(2).join.strip]
    end
  else
    [false, "source worktree is dirty:\n#{dirty}"]
  end
end

# --- 3. dependencies ---------------------------------------------------------

bundle_env = {"BUNDLE_GEMFILE" => File.join(clone, "Gemfile")}
record(steps, failures, "bundle-install") do
  ok, _out, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "install", "--local"], chdir: clone, env: bundle_env
  )
  [ok, ok ? "resolved offline from the local gem cache" : stderr.lines.last(3).join.strip]
end

# --- 4. full gate, both locales ---------------------------------------------

gate_totals = {}
[["C", "gate-lc-c"], [UTF8_LOCALE, "gate-lc-utf8"]].each do |locale, name|
  record(steps, failures, name) do
    ok, stdout, stderr, = run(
      [RbConfig.ruby, "-S", "bundle", "exec", "rake", "ci"],
      chdir: clone, env: bundle_env.merge("LC_ALL" => locale, "LANG" => locale)
    )
    summary = "#{stdout}#{stderr}"[/\d+ runs, \d+ assertions, \d+ failures, \d+ errors, \d+ skips/]
    gate_totals[locale] = summary
    [ok && !summary.nil?, summary || "#{stderr.lines.last(3).join.strip}"]
  end
end

record(steps, failures, "gate-locale-agreement") do
  totals = gate_totals.values.uniq
  [totals.length == 1 && !totals.first.nil?,
   totals.length == 1 ? "identical totals in both locales" : gate_totals.inspect]
end

# --- 5. scorecard ------------------------------------------------------------

scorecard_digest = nil
record(steps, failures, "scorecard") do
  ok, stdout, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "exec", "tamoz-eval", "scorecard", "agent-smoke"],
    chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
  )
  next [false, stderr.lines.last(3).join.strip] unless ok

  report = JSON.parse(stdout)
  aggregate = report.fetch("aggregate")
  scorecard_digest = report.fetch("content_digest")
  problems = []
  problems << "decision #{report.fetch("decision")}" unless report.fetch("decision") == "pass"
  gates = report.fetch("hard_gates")
  unless gates.length == 4 && gates.all? { |gate| gate.fetch("status") == "pass" }
    problems << "hard gates #{gates.inspect}"
  end
  %w[unsafe_or_bypassed_actions false_positive_completions incomplete_case_evidence].each do |counter|
    problems << "#{counter}=#{aggregate.fetch(counter)}" unless aggregate.fetch(counter).zero?
  end
  [problems.empty?,
   problems.empty? ? "#{aggregate.fetch("cases")} cases / " \
                     "#{aggregate.fetch("task_successes")} successes / " \
                     "#{scorecard_digest}" : problems.join("; ")]
end

# --- 6. packaged-gem isolation + per-gem example tasks ----------------------

record(steps, failures, "packaged-gem-isolation") do
  ok, stdout, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "exec", "ruby", "-Itest", "test/packaging_test.rb"],
    chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
  )
  summary = "#{stdout}#{stderr}"[/\d+ runs, \d+ assertions, \d+ failures, \d+ errors, \d+ skips/]
  [ok, summary || stderr.lines.last(3).join.strip]
end

# --- 7. durable restore / resume --------------------------------------------

{
  "durable-kill-resume" => "test/agent_acceptance_workflow_test.rb",
  "backup-restore" => "test/sqlite_backup_test.rb",
  "session-operations" => "test/agent_session_operations_test.rb"
}.each do |name, file|
  record(steps, failures, name) do
    ok, stdout, stderr, = run(
      [RbConfig.ruby, "-S", "bundle", "exec", "ruby", "-Itest", file],
      chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
    )
    summary = "#{stdout}#{stderr}"[/\d+ runs, \d+ assertions, \d+ failures, \d+ errors, \d+ skips/]
    [ok, summary || stderr.lines.last(3).join.strip]
  end
end

# --- 7b. the release evaluation pin -----------------------------------------

record(steps, failures, "release-evaluation-pin") do
  ok, stdout, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "exec", "ruby",
     "script/generate_release_evaluation_manifest"],
    chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
  )
  # The generator RE-RUNS the harness and compares; without `--accept` it
  # verifies rather than re-pinning, so a drifted corpus fails here instead of
  # quietly re-pinning itself inside a rehearsal.
  [ok, ok ? stdout.strip.lines.last.to_s.strip : stderr.lines.last(3).join.strip]
end

# --- 7c. the performance benchmark -------------------------------------------

record(steps, failures, "benchmark") do
  ok, stdout, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "exec", "ruby", "script/benchmark_release"],
    chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
  )
  # Only the GATED counters can fail here; latency is measured and published,
  # never gated, because a clean-clone machine is not the machine the committed
  # numbers were taken on.
  [ok, ok ? stdout.lines.grep(/durability overhead/).first.to_s.strip : stderr.lines.last(3).join.strip]
end

# --- 8. requirements audit (recorded, not gating) ---------------------------

audit_summary = nil
record(steps, failures, "requirements-audit") do
  ok, _stdout, stderr, = run(
    [RbConfig.ruby, "-S", "bundle", "exec", "ruby", "script/generate_requirements_audit",
     "--jobs", "4"],
    chdir: clone, env: bundle_env.merge("LC_ALL" => UTF8_LOCALE, "LANG" => UTF8_LOCALE)
  )
  audit = JSON.parse(read_utf8(File.join(clone, "docs", "requirements-audit.json")))
  audit_summary = {
    "counts" => audit.fetch("counts"),
    "release_blocking_gaps" => audit.fetch("release_blocking_gaps"),
    "definition_of_done_met" => audit.fetch("definition_of_done_met")
  }
  # The audit's own exit status is about FAILING evidence. Remaining gaps are
  # the owner's P15-I decision and must not be waved through here.
  [ok, ok ? "#{audit.fetch("counts").inspect}, gaps: " \
            "#{audit.fetch("release_blocking_gaps").inspect}" : stderr.lines.last(3).join.strip]
rescue Errno::ENOENT, JSON::ParserError => error
  [false, "audit produced no readable artifact: #{error.class}"]
end

puts

recorded = steps.map { |step| step.fetch("step") }
unless recorded == STEP_NAMES
  failures << "step declaration drift: recorded #{recorded.inspect}, declared #{STEP_NAMES.inspect}"
  steps << {"step" => "step-declaration", "ok" => false, "seconds" => 0.0,
            "note" => "recorded steps do not match STEP_NAMES"}
end

# --- evidence ----------------------------------------------------------------

report = {
  "format_version" => 1,
  "generated_by" => "script/release_rehearsal",
  "generated_at" => Time.now.utc.iso8601,
  "candidate_commit" => candidate,
  "toolchain" => {
    "ruby" => RUBY_VERSION, "pinned_ruby" => expected_ruby,
    "bundler" => running_bundler, "lockfile_bundler" => expected_bundler,
    "platform" => RUBY_PLATFORM
  },
  "gate_totals" => gate_totals,
  "scorecard_content_digest" => scorecard_digest,
  "requirements_audit" => audit_summary,
  "steps" => steps,
  "ok" => failures.empty?
}
File.write(LOG_JSON, "#{JSON.pretty_generate(report)}\n")

lines = []
lines << "# Release rehearsal (P15-H)"
lines << ""
lines << "Generated by `script/release_rehearsal`. Every step runs in a CLEAN CLONE of the"
lines << "candidate commit with a pinned toolchain — never in the development checkout."
lines << ""
lines << "| Field | Value |"
lines << "|---|---|"
lines << "| Candidate commit | `#{candidate}` |"
lines << "| Ruby | `#{RUBY_VERSION}` (pinned `#{expected_ruby}`) |"
lines << "| Bundler | `#{running_bundler}` (lockfile `#{expected_bundler}`) |"
lines << "| Platform | `#{RUBY_PLATFORM}` |"
lines << "| Scorecard digest | `#{scorecard_digest}` |"
lines << "| Rehearsal outcome | #{failures.empty? ? "**pass**" : "**FAIL**"} |"
lines << ""
lines << "## Steps"
lines << ""
lines << "| Step | Result | Seconds | Detail |"
lines << "|---|---|---:|---|"
steps.each do |step|
  lines << "| #{step.fetch("step")} | #{step.fetch("ok") ? "pass" : "**FAIL**"} | " \
           "#{step.fetch("seconds")} | #{step["note"].to_s.gsub("\n", " ")} |"
end
lines << ""
if audit_summary
  lines << "## Requirements audit at the candidate"
  lines << ""
  lines << "| Status | Rows |"
  lines << "|---|---:|"
  audit_summary.fetch("counts").each { |status, count| lines << "| #{status} | #{count} |" }
  lines << ""
  gaps = audit_summary.fetch("release_blocking_gaps")
  if gaps.empty?
    lines << "No release-blocking gaps."
  else
    lines << "**Release-blocking gaps remaining: #{gaps.join(", ")}.** These are the P15-I"
    lines << "owner decisions. A passing rehearsal does not close them and does not make"
    lines << "this commit releasable."
  end
  lines << ""
end
unless failures.empty?
  lines << "## Failures"
  lines << ""
  failures.each { |failure| lines << "- #{failure}" }
  lines << ""
end
File.write(LOG_MD, lines.join("\n"))

if keep
  puts "clone kept at #{clone}"
else
  FileUtils.remove_entry(workdir)
end

puts "wrote #{LOG_MD} and #{LOG_JSON}"
steps.each { |step| puts "  #{step.fetch("ok") ? "pass" : "FAIL"}  #{step.fetch("step")}  #{step["note"]}" }
if failures.empty?
  puts "rehearsal PASSED at #{candidate}"
  exit 0
end
warn "rehearsal FAILED: #{failures.length} step(s)"
exit 1
