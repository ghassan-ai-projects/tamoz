#!/usr/bin/env ruby
# frozen_string_literal: true

# P18/C8 (docs/P18_CAPABILITY_HOST_PLAN.md §3) — the graph surface audit
# generator.
#
# Method: Ruby stdlib Coverage (methods: true) loaded into each product
# test subprocess via a RUBYOPT hook (script/coverage_hook.rb) that dumps the
# result to a per-test JSON file on exit. The generator merges the artifacts
# by canonical source path, probes each graph manifest entry, and classifies:
#
#   product_method_executed  — a method of a graph constant ran during a
#                              product-behavior test.
#   manifest_resolved_only   — the constant resolves but no method ran.
#   manifest_unresolved      — the constant no longer resolves.
#
# The MEASURED columns are separated from the PROMOTION RECOMMENDATION column
# (policy, arbitrated at P15-A — the audit does NOT make de facto API
# decisions, C8). `docs/public-api.json` is regenerated with a generated_at
# stamp. Regenerable by RUNNING THIS SCRIPT; divergence raises
# AuditMismatchError.
#
# Note: `test_only_method_executed` is derived from the graph gem's own test
# suite separately (the plan's named column); the product-run column here is
# the executed surface.

require "json"
require "fileutils"
require "open3"
require "tmpdir"
require "time"

ROOT = File.expand_path("..", __dir__)
AUDIT_PATH = File.join(ROOT, "docs", "GRAPH_SURFACE_AUDIT.md")
MANIFEST_PATH = File.join(ROOT, "docs", "public-api.json")

class AuditMismatchError < StandardError; end

# The product-behavior tests whose execution exercises the graph through the
# runtime (the agent session is the graph's product consumer).
#
# The unattended path is included deliberately. A worker cannot complete a task
# without compiling and executing a graph, so it was always structurally a graph
# consumer — but "structurally true" is not this project's standard for a claim.
# Measuring the autonomous path is what turns "the worker must be using the
# graph" into evidence that it does, and it is the path that will exercise
# recovery and interrupt entry points the interactive tests never reach.
#
# The autonomy scorecard is deliberately NOT here: it is a milestone gate whose
# unmet cases fail on purpose, and this audit requires its inputs to pass.
PRODUCT_TESTS = %w[
  test/agent_session_test.rb
  test/agent_runtime_test.rb
  test/agent_cli_test.rb
  test/agent_session_effect_test.rb
  test/agent_worker_test.rb
  test/agent_schedule_test.rb
  test/agent_unattended_policy_test.rb
].freeze

LIB_PATHS = Dir[File.join(ROOT, "gems", "*", "lib")].sort
                   .map { |path| "-I#{path}" }.join(":")

# --- run the product tests with the coverage hook ---------------------------

artifacts = {}
Dir.mktmpdir("tamoz-audit") do |tmpdir|
  PRODUCT_TESTS.each_with_index do |relative, index|
    dump = File.join(tmpdir, "coverage-#{index}.json")
    env = {
      "RUBYOPT" => "-r#{File.join(ROOT, "script", "coverage_hook.rb")} #{LIB_PATHS}",
      "COVERAGE_DUMP" => dump
    }
    stdout, stderr, status = Open3.capture3(
      env, RbConfig.ruby, "-Itest", "-Ilib", relative, chdir: ROOT
    )
    unless status.success?
      warn "product test #{relative} failed (exit #{status.exitstatus}); stderr tail:"
      warn stderr.to_s.lines.last(8).join
      warn "stdout tail:"
      warn stdout.to_s.lines.last(8).join
      raise AuditMismatchError, "product test #{relative} did not pass under Coverage"
    end
    artifact = JSON.parse(File.read(dump, encoding: Encoding::UTF_8))
    artifact.each do |path, data|
      next unless path.start_with?(File.join(ROOT, "gems", "tamoz-graph", "lib"))

      (artifacts[path] ||= {})["methods"] ||= []
      data.fetch("methods", []).each do |signature, hits|
        artifacts[path]["methods"] << signature if hits.to_i.positive?
      end
    end
  end
end

executed_methods = artifacts.transform_values { |data| data.fetch("methods", []).uniq }

# --- load the gems for the manifest probe -----------------------------------

LIB_PATHS.split(":").each { |flag| $LOAD_PATH.unshift(flag.delete_prefix("-I")) }
require "tamoz/core"
require "tamoz/graph"

# --- manifest probe ---------------------------------------------------------

def resolve(entry)
  if entry.match?(/\.[a-z_][a-z0-9_]*[!?]?\z/)
    constant_name, _separator, method_name = entry.rpartition(".")
    constant = constant_name.split("::").reject(&:empty?).reduce(Object) do |scope, name|
      scope.const_get(name, false)
    end
    [constant, method_name]
  else
    constant = entry.split("::").reject(&:empty?).reduce(Object) do |scope, name|
      scope.const_get(name, false)
    end
    [constant, nil]
  end
end

graph_manifest = JSON.parse(File.read(MANIFEST_PATH, encoding: Encoding::UTF_8))
                     .fetch("packages").fetch("tamoz-graph")

# Split a Coverage signature into [class, method]. Coverage records:
#   "Klass#method"        — instance methods (a hash separator)
#   "#<Class:Tamoz>#graph" — module functions (singleton class form)
#   "Mod.method"          — the dotted form (defensive; the hook emits #)
def parse_signature(signature)
  if signature.start_with?("#<Class:") && signature.include?(">#")
    klass, method = signature.delete_prefix("#<Class:").split(">#", 2)
    [klass, method]
  else
    signature.split(/#|\./, 2)
  end
end

rows = []
graph_manifest.each do |entry, options|
  begin
    constant, entry_method = resolve(entry)
    # The "class" of a manifest entry for matching purposes: the constant's
    # name when it is a Class/Module, otherwise the entry itself (a value like
    # START/END/VERSION has no methods to execute).
    constant_name =
      if constant.is_a?(Module)
        constant.name
      else
        entry
      end
  rescue NameError
    rows << [entry, "manifest_unresolved", "P15-A: reconcile", "?"]
    next
  end

  short_name = constant_name.split("::").last
  # An executed method "belongs to" the constant when its signature's class
  # part matches the constant's full name or short name, AND — when the
  # manifest entry names a method (e.g. `Tamoz.graph`) — the method part
  # matches too. Matching class alone would credit every entry of a class on
  # the strength of ONE executed method (e.g. the internal `Reducers.resolve`
  # must not credit the five `Reducers.*` reducers). Module functions are
  # recorded by Coverage as "#<Class:Tamoz>#graph" (a singleton-class
  # signature): the "#<Class:NAME>" form is normalized back to NAME so
  # `Tamoz.graph` / `Tamoz.interrupt` are credited as executed. Instance
  # methods are "Klass#method" (a hash); module functions are
  # "Mod.method" or the "#<Class:Mod>#method" singleton form.
  product_hits = executed_methods.values.flatten
  exercised = product_hits.any? do |signature|
    klass, method = parse_signature(signature)
    class_matches =
      klass == constant_name ||
      klass.end_with?("::#{short_name}") ||
      klass == short_name
    next false unless class_matches

    entry_method.nil? || method == entry_method
  end

  measured = if exercised
               "product_method_executed"
             elsif options["deprecated"]
               "manifest_resolved_only (deprecated alias)"
             else
               "manifest_resolved_only"
             end
  # The promotion recommendation is POLICY, arbitrated at P15-A — the audit
  # derives it from the MEASURED column but never decides it (C8). The
  # recommendation names the P15-A action, not a de facto API decision.
  recommendation = case measured
                   when "product_method_executed"
                     "P15-A: promote candidate"
                   when "manifest_unresolved"
                     "P15-A: reconcile"
                   else
                     "P15-A: review"
                   end
  rows << [entry, measured, recommendation, constant_name]
end

# --- emit the audit ---------------------------------------------------------

rows.sort_by! { |row| [row[1] == "manifest_unresolved" ? 1 : 0, row[0]] }

lines = []
lines << "# Graph surface audit"
lines << ""
lines << "Generated by `script/generate_graph_surface_audit` (Ruby stdlib Coverage,"
lines << "`methods: true`, loaded into each product-behavior test subprocess via"
lines << "`script/coverage_hook.rb`). Product tests: #{PRODUCT_TESTS.join(", ")}."
lines << ""
lines << "**Measured columns are separated from the promotion recommendation.** The"
lines << "recommendation column is POLICY, arbitrated at P15-A — the audit does not make"
lines << "de facto API decisions (P18 plan §3, C8)."
lines << ""
lines << "| Entry | Measured | Recommendation | Constant |"
lines << "|---|---|---|---|"
rows.each do |entry, measured, recommendation, constant_name|
  lines << "| `#{entry}` | #{measured} | #{recommendation} | `#{constant_name}` |"
end
lines << ""

content = lines.join("\n")

# Regenerable determinism (H5): the committed table IS the regeneration
# output. Running the script verifies the committed table against a fresh
# run; divergence raises AuditMismatchError instead of silently overwriting.
# `--accept` (or P18_AUDIT_ACCEPT=1) writes the regenerated table — the
# deliberate reconciliation path after a measured change.
accepted = ARGV.include?("--accept") || ENV["P18_AUDIT_ACCEPT"] == "1"
# The committed table is read as UTF-8 explicitly: under a non-UTF-8 locale
# (LC_ALL=C) the default external encoding is US-ASCII, and a byte-identical
# file tagged US-ASCII never compares equal to the UTF-8 `content` — a false
# AuditMismatchError that fails the gate on locale alone.
if File.exist?(AUDIT_PATH) &&
   File.read(AUDIT_PATH, encoding: Encoding::UTF_8) != content && !accepted
  raise AuditMismatchError,
        "regenerated graph surface audit diverges from the committed table; " \
        "re-run with --accept after reconciling (P15-A)"
end

File.write(AUDIT_PATH, content)
puts "wrote #{AUDIT_PATH} (#{rows.length} entries)"

# --- regenerate public-api.json ---------------------------------------------
#
# The stamp moves ONLY when the inventory content moves. Stamping every run
# made `rake ci` dirty the worktree (the audit test runs this generator), and a
# gate that cannot leave a clean tree fails P15's own release criterion — the
# rehearsal would report a dirty checkout on a repository nobody edited.

# Every manifest entry this run probed resolved (an unresolved entry is already
# a `manifest_unresolved` row above), so the inventory content is confirmed, not
# recomputed. The file is rewritten only when its bytes would actually change;
# the stamp is not touched otherwise.

inventory = JSON.parse(File.read(MANIFEST_PATH, encoding: Encoding::UTF_8))
inventory["generated_at"] ||= Time.now.utc.iso8601
serialized = "#{JSON.pretty_generate(inventory)}\n"
if File.read(MANIFEST_PATH, encoding: Encoding::UTF_8) == serialized
  puts "docs/public-api.json confirmed unchanged"
else
  File.write(MANIFEST_PATH, serialized)
  puts "rewrote docs/public-api.json"
end
