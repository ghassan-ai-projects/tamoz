#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(*Dir[File.expand_path("../gems/*/lib", __dir__)])
$LOAD_PATH.unshift(File.expand_path("../test", __dir__))
require "json"
require "tamoz/agent"
require "tamoz/stream/episode_worker"
require "support/aquaculture_domain"
require "support/climate_domain"

# P7: generates the machine-readable benchmark protocol (the freeze). It is a
# committed artifact — a change to ANY field is a NEW benchmark version, and
# the regression test asserts byte-identical regeneration + the committed
# SHA-256 pin.
def main
  sealed = Tamoz::Agent::SealedBuild.new.canonical_fingerprint
  protocol = {
    "benchmark_protocol_version" => "1.0.0",
    "sealed_build_digest" => sealed,
    "graph" => {
      "name" => Tamoz::Agent::EpisodeGraph::GRAPH_NAME,
      "version" => Tamoz::Agent::EpisodeGraph::GRAPH_VERSION
    },
    "digests" => {
      "diagnosis_catalog" => Tamoz::Core.digest(:diagnosis_catalog, AquacultureDomain::CATALOG),
      "intent_catalog_aquaculture" => AquacultureDomain.intent_catalog_digest,
      "intent_catalog_climate" => ClimateDomain.intent_catalog_digest,
      "prompt_aquaculture" => Tamoz::Core.digest(
        "situation-runtime/prompt/v1\n", {"version" => "1.0", "text" => AquacultureDomain::PROMPT}
      ),
      "prompt_climate" => Tamoz::Core.digest(
        "situation-runtime/prompt/v1\n", {"version" => "1.0", "text" => ClimateDomain::PROMPT}
      )
    },
    "providers" => [
      {"identity" => "local-model", "provider" => "tamoz-local", "settings" => {
        "temperature" => 0, "stream" => false, "response_format" => "json_object"
      }},
      {"identity" => "pinned-local", "provider" => "tamoz-local-pinned", "settings" => {
        "temperature" => 0, "stream" => false, "response_format" => "json_object"
      }}
    ],
    "budgets" => {
      "max_model_calls" => 8,
      "max_output_tokens" => 2048,
      "wall_time" => "60s",
      "risk_ceiling" => "R2"
    },
    "case_matrix" => {
      "domains" => %w[aquaculture climate],
      "scenario_families" => [
        {"id" => "do-crash", "domain" => "aquaculture", "primary" => "low_dissolved_oxygen",
         "metric" => "dissolved_oxygen", "alarm_code" => "low_dissolved_oxygen"},
        {"id" => "climate-deviation", "domain" => "climate", "primary" => "overheated",
         "metric" => "zone_temperature", "alarm_code" => "overheated"}
      ],
      "min_cases_per_cell" => 30
    },
    "scoring" => {
      "diagnosis" => {
        "macro_f1" => "macro-averaged F1 over the diagnosis codes",
        "balanced_accuracy" => "mean recall over the diagnosis codes"
      },
      "probability" => {
        "brier" => "mean squared error over the full probability vector",
        "log_loss" => "negative log likelihood over the full probability vector",
        "calibration" => "ECE over the primary-code probabilities",
        "risk_coverage" => "coverage vs risk under abstention"
      },
      "evidence" => {
        "fabricated_reference_rate" => "hard zero gate"
      },
      "timing" => {"lead_time" => "decision time vs the first-observable time"},
      "utility" => {
        "missed_catastrophe_cost" => 100.0,
        "false_action_cost" => 1.0
      },
      "cost" => {"per_cell" => "provider tokens + tool bytes per cell"}
    },
    "baselines" => [
      "majority_prior", "random_label", "fixed_threshold", "z_score",
      "first_difference", "moving_median", "nearest_symptom",
      "deterministic_detector", "go_native_executor"
    ],
    "thresholds" => {
      "minimum_practical_effect" => 0.05,
      "confidence_interval" => 0.95,
      "safety_cost_floors" => {"per_scenario" => true}
    },
    "stop_rules" => [
      "truth_leak", "holdout_access", "fixture_or_fake_provider",
      "forged_or_missing_witness_record", "artifact_mismatch",
      "fabricated_evidence_reference", "cross_cell_memory",
      "hidden_domain_code", "silent_fallback", "accepted_risk_mismatch",
      "unreported_attempt"
    ],
    "statistics" => {
      "intention_to_treat" => true,
      "first_attempt_scored" => true,
      "failures_never_replaced" => true,
      "paired_seeds_across_providers_and_baselines" => true,
      "cluster_bootstrap_intervals" => true,
      "min_cases_per_cell" => 30
    }
  }
  puts JSON.pretty_generate(protocol)
end

main
