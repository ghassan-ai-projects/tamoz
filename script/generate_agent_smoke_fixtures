#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

$LOAD_PATH.unshift(File.expand_path("../gems/tamoz-core/lib", __dir__))
$LOAD_PATH.unshift(File.expand_path("../gems/tamoz-evals/lib", __dir__))
require "tamoz/evals"

root = ENV.fetch("TAMOZ_FIXTURE_ROOT", File.expand_path("../gems/tamoz-evals", __dir__))
case_root = File.join(root, "suites", "agent", "smoke")
source_root = File.expand_path("../gems/tamoz-evals/suites/agent/smoke", __dir__)
FileUtils.mkdir_p(case_root)

def write_case(path, document)
  document["content_digest"] = Tamoz::Evals::CanonicalJSON.content_digest(
    document,
    domain: "eval.case"
  )
  File.write(
    path,
    "#{Tamoz::Evals::CanonicalJSON.dump(document)}\n",
    encoding: Encoding::UTF_8
  )
end

def case_document(index, definition)
  {
    "artifact_type" => "case",
    "format_version" => 1,
    "digest_version" => 1,
    "content_digest" => "pending",
    "case_id" => definition.fetch("case_id"),
    "case_version" => 1,
    "suite_id" => Tamoz::Evals::Harness::AgentSmokeCorpus::SUITE_ID,
    "split" => "development",
    "title" => definition.fetch("title"),
    "purpose" => definition.fetch("purpose"),
    "tags" => definition.fetch("tags"),
    "risk_class" => definition.fetch("risk_class"),
    "input" => {
      "kind" => "tamoz-agent-smoke",
      "payload" => {
        "scenario" => definition.fetch("scenario"),
        "task" => definition.fetch("task")
      }
    },
    "environment" => {
      "profile" => "pr",
      "isolation" => definition.fetch("isolation", "in_process"),
      "network" => "recorded"
    },
    "capabilities" => {
      "allowed" => definition.fetch("allowed"),
      "prohibited" => definition.fetch("prohibited")
    },
    "definition_of_done" => definition.fetch("done"),
    "evidence" => {
      "required" => [
        {
          "id" => format("agent.smoke.evidence.%02d", index),
          "kind" => "state",
          "oracle" => definition.fetch(
            "evidence_oracle",
            "The controller-owned deterministic oracle scores task state and runtime events."
          )
        }
      ],
      "optional" => []
    },
    "scorers" => [
      {
        "id" => "tamoz.agent-smoke.deterministic",
        "kind" => "deterministic",
        "version" => "v1"
      }
    ],
    "budgets" => {
      "turns" => definition.fetch("turns", 1),
      "steps" => 36,
      "tool_calls" => 20,
      "tokens" => 0,
      "cost_microusd" => 0,
      "time_ms" => definition.fetch("time_ms", 5_000)
    },
    "repetitions" => {
      "count" => 1,
      "comparison_method" => "exact"
    },
    "content_policy" => {
      "classification" => "public",
      "capture" => "metadata"
    },
    "references" => []
  }
end

unless File.expand_path(case_root) == File.expand_path(source_root)
  FileUtils.rm_f(Dir[File.join(case_root, "*.case.json")])
  FileUtils.cp(Dir[File.join(source_root, "*.case.json")], case_root)
end
