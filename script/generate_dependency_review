#!/usr/bin/env ruby
# frozen_string_literal: true

# P15-D (docs/P15_RELEASE_PLAN.md §6) — the dependency, license and provenance
# review.
#
# What a release needs to state honestly is not "we use some gems" but: which
# third-party code enters a PRODUCTION process, under what licence, pinned how,
# and from whom. The distinction that matters is runtime versus development —
# `minitest` and `rake` never ship, `sqlite3` and `zeitwerk` are in every
# durable session.
#
# The runtime closure is computed from the nine gemspecs' own declared runtime
# dependencies, transitively resolved against the lockfile. It is therefore the
# real closure, not a hand-kept list: a new runtime dependency appears here the
# moment a gemspec declares it, and `test/dependency_review_test.rb` fails
# until the committed report is regenerated and its licence is on the
# permissive allowlist.

require "json"
require "bundler"

ROOT = File.expand_path("..", __dir__)
REPORT_MD = File.join(ROOT, "docs", "DEPENDENCY_REVIEW.md")
REPORT_JSON = File.join(ROOT, "docs", "dependency-review.json")

GEMS = %w[
  tamoz-core tamoz-graph tamoz-scheduler tamoz-stream tamoz-sqlite
  tamoz-tools tamoz-agent tamoz-mcp tamoz-evals
].freeze

# Licences that may enter a production Tamoz process. Every entry is permissive
# and imposes no reciprocal obligation on a user of the gems. A copyleft licence
# is not "not allowed" as a value judgement — it is a decision the OWNER must
# make explicitly, so it fails the gate rather than arriving silently.
PERMISSIVE = [
  "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "Ruby",
  "Ruby/BSD-2-Clause", "MIT/Apache-2.0"
].freeze

# Runtime-closure gems that are NOT invoked by Tamoz runtime code, with the
# documented reason. The gate test allows a row ONLY when this map explains it;
# a new un-excepted dev-tool leak still fails.
RUNTIME_EXCEPTIONS = {
  "rake" => "google-protobuf's own gemspec declares rake as a runtime " \
            "dependency (upstream quirk); Tamoz runtime code never invokes it - " \
            "build tooling only"
}.freeze

# Licences pinned for closure gems whose spec cannot be resolved in the
# bundler environment (never installed on the platforms that ship). Pinned
# entries must name the permissive licence explicitly; an entry here without a
# matching permissive value still fails the gate.
KNOWN_LICENSES = {
  "mini_portile2" => ["MIT"]
}.freeze

lock = Bundler::LockfileParser.new(File.read(File.join(ROOT, "Gemfile.lock")))

# A gem with a precompiled variant appears twice in the lockfile, and the two
# entries carry DIFFERENT dependencies (`sqlite3 (2.9.5)` needs mini_portile2;
# `sqlite3 (2.9.5-arm64-darwin)` does not). Taking whichever came last made the
# runtime closure depend on the machine that generated the report. The generic
# spec is the superset, so it is the one this gate asks about.
locked = lock.specs.each_with_object({}) do |spec, store|
  current = store[spec.name]
  store[spec.name] = spec if current.nil? || spec.platform.to_s == "ruby"
end

# Licence and homepage can only be read from an installed gem, and a precompiled
# variant means a gem in the lockfile may be installed on one platform and not
# another. Carrying the committed value forward keeps the report identical
# everywhere instead of blanking rows the local machine happens to lack.
PREVIOUS = if File.exist?(REPORT_JSON)
             JSON.parse(File.read(REPORT_JSON))
                 .values_at("runtime", "development")
                 .compact
                 .flatten
                 .to_h { |row| [row.fetch("name"), row] }
           else
             {}
           end

def spec_for(name, version)
  Gem::Specification.find_by_name(name, version.to_s)
rescue Gem::MissingSpecError, Gem::LoadError
  nil
end

# --- the runtime closure -----------------------------------------------------

declared = {}
GEMS.each do |gem_name|
  path = File.join(ROOT, "gems", gem_name, "#{gem_name}.gemspec")
  specification = Dir.chdir(File.dirname(path)) { Gem::Specification.load(path) }
  specification.dependencies.select { |dep| dep.type == :runtime }.each do |dependency|
    next if dependency.name.start_with?("tamoz-")

    (declared[dependency.name] ||= []) << [gem_name, dependency.requirement.to_s]
  end
end

runtime = {}
frontier = declared.keys.dup
until frontier.empty?
  name = frontier.shift
  next if runtime.key?(name)

  locked_spec = locked[name]
  next unless locked_spec

  runtime[name] = locked_spec
  locked_spec.dependencies.each { |dependency| frontier << dependency.name }
end

development = locked.reject { |name, spec| runtime.key?(name) || spec.source.is_a?(Bundler::Source::Path) }

def carried_row(name, version)
  row = PREVIOUS[name]
  row if row && row["version"] == version
end

def licences_for(installed, carried, name)
  declared = installed&.licenses.to_a
  declared = Array(KNOWN_LICENSES[name]) if declared.empty? && KNOWN_LICENSES.key?(name)
  declared = carried["licenses"].to_a if declared.empty? && carried
  declared.empty? ? ["UNDECLARED"] : declared
end

def describe(name, locked_spec, declared)
  version = locked_spec.version.to_s
  installed = spec_for(name, version)
  carried = carried_row(name, version)
  {
    "name" => name,
    "version" => version,
    "licenses" => licences_for(installed, carried, name),
    "homepage" => installed&.homepage || carried&.[]("homepage"),
    "required_by" => (declared[name] || []).map { |gem_name, requirement| "#{gem_name} #{requirement}" },
    "direct" => declared.key?(name),
    "exception" => RUNTIME_EXCEPTIONS[name]
  }
end

runtime_rows = runtime.keys.sort.map { |name| describe(name, runtime.fetch(name), declared) }
development_rows = development.keys.sort.map { |name| describe(name, development.fetch(name), {}) }

violations = runtime_rows.reject do |row|
  row.fetch("licenses").all? { |license| PERMISSIVE.include?(license) }
end

document = {
  "format_version" => 1,
  "generated_by" => "script/generate_dependency_review",
  "permissive_licenses" => PERMISSIVE,
  "runtime_exceptions" => RUNTIME_EXCEPTIONS,
  "runtime" => runtime_rows,
  "development" => development_rows,
  "license_violations" => violations.map { |row| row.fetch("name") }
}
File.write(REPORT_JSON, "#{JSON.pretty_generate(document)}\n")

lines = []
lines << "# Dependency, licence and provenance review (P15-D)"
lines << ""
lines << "Generated by `script/generate_dependency_review` from the nine gemspecs'"
lines << "own declared runtime dependencies, transitively resolved against"
lines << "`Gemfile.lock`. It is the REAL closure, not a hand-kept list: a new runtime"
lines << "dependency appears here the moment a gemspec declares it, and the gate fails"
lines << "until this file is regenerated."
lines << ""
lines << "## Runtime — third-party code that enters a production Tamoz process"
lines << ""
lines << "| Gem | Version | Licence | Direct | Required by | Provenance |"
lines << "|---|---|---|---|---|---|"
runtime_rows.each do |row|
  lines << "| `#{row.fetch("name")}` | #{row.fetch("version")} | " \
           "#{row.fetch("licenses").join(", ")} | " \
           "#{row.fetch("direct") ? "yes" : "transitive"} | " \
           "#{row.fetch("required_by").join("; ")} | #{row["homepage"]} |"
end
lines << ""
lines << "Every runtime licence must be on the permissive allowlist"
lines << "(#{PERMISSIVE.join(", ")}). A copyleft dependency is not forbidden as a value"
lines << "judgement — it is an OWNER decision, so it fails the gate rather than"
lines << "arriving silently."
lines << ""
if violations.empty?
  lines << "**No licence violations.**"
else
  lines << "**Licence violations: #{violations.map { |row| row.fetch("name") }.join(", ")}.**"
end
lines << ""
lines << "## Development only — never shipped"
lines << ""
lines << "| Gem | Version | Licence |"
lines << "|---|---|---|"
development_rows.each do |row|
  lines << "| `#{row.fetch("name")}` | #{row.fetch("version")} | #{row.fetch("licenses").join(", ")} |"
end
lines << ""
lines << "`tamoz-evals` is a development-time gem by contract: no production gemspec may"
lines << "depend on it, enforced by `test/dependency_isolation_test.rb`."
lines << ""
lines << "## Provenance"
lines << ""
lines << "- Every version above is PINNED by `Gemfile.lock`; the lockfile is committed."
lines << "- Each Tamoz gemspec requires `rubygems_mfa_required`, so a published gem"
lines << "  cannot be pushed from an account without multi-factor authentication."
lines << "- The clean-clone rehearsal installs offline from the local gem cache, so a"
lines << "  release candidate is reproducible without a network fetch that could resolve"
lines << "  differently."
lines << "- Tamoz fetches no code at runtime: there is no plugin loader, no gem install"
lines << "  path, and no skill-install pipeline (see `docs/LIMITATIONS.md`)."
lines << ""
File.write(REPORT_MD, lines.join("\n"))

puts "wrote #{REPORT_MD} and #{REPORT_JSON}"
puts "  runtime: #{runtime_rows.length}, development: #{development_rows.length}"
puts "  licence violations: #{violations.map { |row| row.fetch("name") }.inspect}"
exit(violations.empty? ? 0 : 1)
