#!/usr/bin/env ruby
# frozen_string_literal: true

# Q0-5 — deterministic quality-baseline generator (docs/QUALITY_PROGRAM.md §Q0).
#
# Produces docs/code-quality-baseline.json and docs/CODE_QUALITY.md from the
# installed toolchain: RuboCop raw ledger, Reek raw ledger (per-context),
# SimpleCov resultset, Enola snapshot + check, dependency review, public API,
# autonomy scorecard, benchmark, test totals, and LOC counts.
#
# The committed artifacts are regenerated by THIS script alone — a hand edit
# is overwritten on the next regeneration (docs/CODING_STANDARD.md §2). CI
# drift detection (Q1) compares the committed files against a fresh run.
#
# Run from the repo root:  ruby script/regenerate_quality_baseline
# Takes ~2-3 minutes (includes RUN_COVERAGE=1 rake test).
#
# Branch totals are computed from the SimpleCov resultset directly: a branch
# leaf is covered when its hit count is positive. Line numbers match
# SimpleCov's own report exactly; branch totals can differ by a single branch
# from SimpleCov's printed summary (definitional edge in its counting) — the
# committed numbers are the deterministic ones this script produces.

require 'fileutils'
require 'json'
require 'open3'
require 'rbconfig'
require_relative 'quality/coverage_totals'

ROOT = File.expand_path('..', __dir__)
DOCS = File.join(ROOT, 'docs')
TMP = File.join(ROOT, 'tmp')
BASELINE_JSON = File.join(DOCS, 'code-quality-baseline.json')
CODE_QUALITY_MD = File.join(DOCS, 'CODE_QUALITY.md')
REPORT_DIRS = %w[gems script bin apps].freeze

def sh_stdout(*cmd)
  out, err, status = Open3.capture3(*cmd, chdir: ROOT)
  raise "#{cmd.join(' ')} failed: #{err}" unless status.success?

  out
end

def git_state
  commit = sh_stdout('git', 'rev-parse', '--short', 'HEAD').strip
  { 'commit' => commit, 'dirty' => !sh_stdout('git', 'status', '--porcelain').strip.empty? }
end

def toolchain_versions
  %w[rubocop reek simplecov].to_h do |name|
    [name, Gem.loaded_specs.fetch(name).version.to_s]
  end
end

# --- RuboCop raw ledger (against .rubocop.yml WITHOUT the inherited TODO) ---

def raw_rubocop_config
  FileUtils.mkdir_p(TMP)
  path = File.join(TMP, 'rubocop-raw.yml')
  content = File.read(File.join(ROOT, '.rubocop.yml')).sub(/^inherit_from:.*\n/, '')
  File.write(path, content)
  path
end

def rubocop_report
  cfg = raw_rubocop_config
  out = File.join(TMP, 'rubocop-raw.json')
  bin = Gem.bin_path('rubocop', 'rubocop')
  Open3.capture3(RbConfig.ruby, bin, '--config', cfg, '--format', 'json', '--out', out, chdir: ROOT)
  JSON.parse(File.read(out))
end

def offense_totals(report)
  by_cop = Hash.new(0)
  by_severity = Hash.new(0)
  report.fetch('files').each do |file|
    file.fetch('offenses').each do |offense|
      by_cop[offense.fetch('cop_name')] += 1
      by_severity[offense.fetch('severity')] += 1
    end
  end
  [by_cop, by_severity]
end

def metric_overruns(report)
  metrics = Hash.new { |hash, key| hash[key] = [] }
  report.fetch('files').each do |file|
    file.fetch('offenses').each do |offense|
      match = offense.fetch('message', '').match(%r{\[(\d+)/(\d+)\]})
      metrics[offense.fetch('cop_name')] << match[1].to_i if match
    end
  end
  metrics.transform_values { |values| { 'max' => values.max, 'count' => values.size } }
end

def rubocop_ledger
  report = rubocop_report
  by_cop, by_severity = offense_totals(report)
  {
    'total' => report.fetch('summary').fetch('offense_count'),
    'files_inspected' => report.fetch('files').size,
    'by_cop' => by_cop.sort_by { |_cop, count| -count }.to_h,
    'by_severity' => by_severity,
    'metrics_over_ceiling' => metric_overruns(report)
  }
end

# --- Reek raw ledger (context-named) ---

def sorted_by_count(counts)
  counts.sort_by { |_key, count| -count }.to_h
end

def reek_ledger
  bin = Gem.bin_path('reek', 'reek')
  out, = Open3.capture3(RbConfig.ruby, bin, '--format', 'json', *REPORT_DIRS, chdir: ROOT)
  smells = JSON.parse(out)
  by_type = Hash.new(0)
  by_file = Hash.new(0)
  smells.each do |smell|
    by_type[smell.fetch('smell_type')] += 1
    by_file[smell.fetch('source')] += 1
  end
  {
    'total' => smells.size,
    'by_type' => sorted_by_count(by_type),
    'by_file' => sorted_by_count(by_file)
  }
end

# --- SimpleCov coverage (RUN_COVERAGE=1 rake test) ---

def coverage_run
  # MT_SEED is pinned so the coverage measurement is reproducible: a random
  # seed moves a line or two between runs, which would make the Q1 ratchet
  # ("coverage may never decrease") fail on noise instead of regressions.
  out, err, status = Open3.capture3({ 'RUN_COVERAGE' => '1', 'MT_SEED' => '1' }, RbConfig.ruby, '-S',
                                    'bundle', 'exec', 'rake', 'test', chdir: ROOT)
  raise "coverage run failed: #{err}" unless status.success?

  [out, err]
end

def test_summary(output)
  match = output.match(/(\d+) runs, (\d+) assertions/)
  match ? { 'runs' => match[1].to_i, 'assertions' => match[2].to_i } : {}
end

def coverage_stats
  out, err = coverage_run
  totals = QualityCoverage.totals(File.join(ROOT, 'coverage', '.resultset.json'))
  totals.merge('tests' => test_summary("#{out}\n#{err}"))
end

# --- Enola ---

def enola_check_verdict
  bin = ENV.fetch('ENOLA_BIN', File.join(Dir.home, '.local', 'bin', 'enola'))
  out, = Open3.capture3(bin, 'check', '--fail-on=cycles,layers', '--min-confidence=0.8', '.', chdir: ROOT)
  out[/^(PASS|REGRESSION|DECLINED|ERROR)/, 1] || 'UNKNOWN'
end

def enola_stats
  facts = if File.exist?(File.join(ROOT, '.enola',
                                   'facts.jsonl'))
            File.readlines(File.join(ROOT, '.enola', 'facts.jsonl')).size
          else
            0
          end
  insights_path = File.join(ROOT, '.enola', 'insights.json')
  insights = File.exist?(insights_path) ? JSON.parse(File.read(insights_path)) : []
  by_explainer = Hash.new(0)
  insights.each { |insight| by_explainer[insight.fetch('source')] += 1 }
  { 'facts' => facts, 'insights' => insights.size,
    'insights_by_explainer' => by_explainer.sort.to_h,
    'check_verdict' => enola_check_verdict }
end

# --- LOC ---

def code_line_count(path)
  File.readlines(path).count { |line| !line.strip.empty? && !line.strip.start_with?('#') }
end

def production_ruby_files
  ruby_files = Dir[File.join(ROOT, 'gems', '*', 'lib', '**', '*.rb')]
  script_files = Dir[File.join(ROOT, '{script,bin,apps}', '**', '*')].select do |path|
    File.file?(path) && !File.basename(path).start_with?('.')
  end
  ruby_files + script_files
end

def loc_stats
  files = production_ruby_files
  by_directory = Hash.new(0)
  total = 0
  files.each do |path|
    relative = path.delete_prefix("#{ROOT}/")
    count = code_line_count(path)
    by_directory[relative.split('/').first(2).join('/')] += count
    total += count
  end
  { 'files' => files.size, 'total_code_lines' => total,
    'by_directory' => by_directory.sort.to_h }
end

# --- Assembly ---
def summary_of(path)
  full = File.join(DOCS, path)
  return { 'present' => false } unless File.exist?(full)

  document = JSON.parse(File.read(full))
  { 'present' => true, 'top_level_entries' => document.is_a?(Array) ? document.size : document.keys.size }
end

def document_summaries
  %w[dependency-review.json public-api.json autonomy-scorecard.json benchmark.json]
    .to_h { |path| [path.delete_suffix('.json'), summary_of(path)] }
end

def assemble
  {
    'generated_by' => 'script/regenerate_quality_baseline',
    'git' => git_state,
    'toolchain' => toolchain_versions,
    'loc' => loc_stats,
    'rubocop' => rubocop_ledger,
    'reek' => reek_ledger,
    'enola' => enola_stats,
    'coverage' => coverage_stats,
    'documents' => document_summaries
  }
end

# --- Markdown rendering ---

def render_enola(data)
  enola = data.fetch('enola')
  "- facts: **#{enola.fetch('facts')}**, insights: **#{enola.fetch('insights')}**, " \
    "check: **#{enola.fetch('check_verdict')}**\n"
end

def render_rubocop(data)
  rubocop = data.fetch('rubocop')
  lines = ["- offenses: **#{rubocop.fetch('total')}** across " \
           "#{rubocop.fetch('files_inspected')} files (gate run is 0 via the committed TODO)",
           "- severity: #{rubocop.fetch('by_severity')}",
           "- metrics over Q6 ceilings: #{rubocop.fetch('metrics_over_ceiling')}",
           '', '| cop | count |', '| --- | ---: |']
  rubocop.fetch('by_cop').each { |cop, count| lines << "| #{cop} | #{count} |" }
  lines.join("\n")
end

def render_reek(data)
  lines = ["- smells: **#{data.dig('reek', 'total')}**", '', '| smell | count |', '| --- | ---: |']
  data.dig('reek', 'by_type').each { |type, count| lines << "| #{type} | #{count} |" }
  lines.join("\n")
end

def render_coverage(data)
  coverage = data.fetch('coverage')
  [
    "- line: **#{coverage.fetch('line_percent')}%** " \
    "(#{coverage.fetch('line_covered')}/#{coverage.fetch('line_total')})",
    "- branch: **#{coverage.fetch('branch_percent')}%** " \
    "(#{coverage.fetch('branch_covered')}/#{coverage.fetch('branch_total')})",
    "- uncovered files: #{coverage.fetch('uncovered_files').size}",
    "- tests: #{coverage.dig('tests', 'runs')} runs / #{coverage.dig('tests', 'assertions')} assertions"
  ].join("\n")
end

def render_markdown(data)
  lines = [
    '# Code Quality Baseline', '',
    "Generated by `script/regenerate_quality_baseline` at #{data.dig('git', 'commit')}" \
    "#{' (dirty tree)' if data.dig('git', 'dirty')}. Regenerate with: " \
    '`bundle exec ruby script/regenerate_quality_baseline`.', '',
    '## Enola', '', render_enola(data), '', '## RuboCop (raw debt, without the TODO)', '',
    render_rubocop(data), '', '## Reek (raw, context-named ratchet)', '', render_reek(data), '',
    '## Coverage', '', render_coverage(data), '',
    '## LOC', '',
    "- **#{data.dig('loc', 'total_code_lines')}** code lines in **#{data.dig('loc', 'files')}** files",
    "- by directory: #{data.dig('loc', 'by_directory')}", '',
    '## Document summaries', '', "- dependency review: #{data.dig('documents', 'dependency_review', 'present')}",
    "- public api: #{data.dig('documents', 'public_api', 'present')}",
    "- autonomy scorecard: #{data.dig('documents', 'autonomy_scorecard', 'present')}",
    "- benchmark: #{data.dig('documents', 'benchmark', 'present')}", ''
  ]
  lines.join("\n")
end

if $PROGRAM_NAME == __FILE__
  data = assemble
  File.write(BASELINE_JSON, "#{JSON.pretty_generate(data)}\n")
  File.write(CODE_QUALITY_MD, render_markdown(data))
  warn "baseline written: #{BASELINE_JSON}"
end
