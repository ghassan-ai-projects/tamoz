module TamozSQLiteOracle
  VERSION = 1
  APPLICATION_ID = 1_413_565_786
  # P11: the schema moved 1 -> 2 through the checksummed MIGRATION_2 (the
  # lexical memory index). P13: 2 -> 3 through MIGRATION_3 (scheduler tables).
  # P14: 3 -> 4 through MIGRATION_4 (stream tables). Comms: 5 -> 6 through
  # MIGRATION_6 (channel tables). Delivery pacing moved 7 -> 8 through
  # MIGRATION_8. ADR-049: 8 -> 9 (prompt required_evidence) and 9 -> 10
  # (decision audit evidence/reason).
  # The approval-policy redesign collapsed the tail of the registry into
  # MIGRATION_17 (fresh-schema convention): 15 -> 16 gives the effect journal
  # its logical-key identity columns, and 16 -> 17 carries the final approval
  # schema. OpenClaw comms: 17 -> 18 extends the inbound identity with the
  # raw payload digest, 18 -> 19 adds the conversation generation counter and
  # the outbox reply_to column, and 19 -> 20 bounds conflict amplification to
  # one anchor row per update_id.
  # The oracle is a second, independent read-only verifier: it
  # must agree with the migrated schema or every scenario database is
  # schema_invalid.
  SCHEMA_VERSION = 20
  MIGRATION_1_CHECKSUM =
    "d27658b46031e0484dac3ab1a37364b125b01c4a2dbc8a72f3be71e2771c8814"
