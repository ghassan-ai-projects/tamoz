#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(*Dir[File.expand_path('../gems/*/lib', __dir__)])

require 'json'
require 'optparse'
require 'tamoz/evals'

options = { artifact_base: Dir.pwd }
OptionParser.new do |parser|
  parser.banner = 'Usage: script/benchmark_openclaw_regression --scoreboard PATH --manifest PATH'
  parser.on('--scoreboard PATH') { |value| options[:scoreboard] = value }
  parser.on('--manifest PATH') { |value| options[:manifest] = value }
  parser.on('--artifact-base PATH') { |value| options[:artifact_base] = value }
end.parse!

missing = %i[scoreboard manifest].reject { |key| options.key?(key) }
abort "missing required options: #{missing.join(', ')}" unless missing.empty?

begin
  manifest = JSON.parse(File.read(options.fetch(:manifest), encoding: Encoding::UTF_8))
  result = Tamoz::Evals::Benchmark::Scoreboard.regression_check(
    scoreboard_path: options.fetch(:scoreboard), manifest:, artifact_base: options.fetch(:artifact_base)
  )
  puts Tamoz::Evals::CanonicalJSON.dump(result)
rescue JSON::ParserError => e
  warn "benchmark regression gate failed: invalid JSON: #{e.message}"
  exit 2
rescue KeyError => e
  warn "benchmark regression gate failed: missing field #{e.key.inspect}"
  exit 2
rescue Tamoz::Evals::Benchmark::Scoreboard::RegressionError => e
  warn "benchmark regression gate failed: #{e.message}"
  exit 1
rescue Tamoz::Evals::Benchmark::Scoreboard::Error => e
  warn "benchmark regression gate failed: #{e.message}"
  exit 2
end
