# --- source parsers ----------------------------------------------------------

def read_utf8(path) = File.read(path, encoding: Encoding::UTF_8)

def parse_invariants
  text = read_utf8(File.join(ROOT, "docs", "design-v0.1", "INVARIANTS.md"))
  rows = []
  text.each_line do |line|
    match = line.match(/\A\|\s*(\d+)\s*\|\s*\*\*(.+?)\*\*\s*\|/)
    next unless match

    rows << {number: match[1].to_i, title: match[2].strip}
  end
  rows.sort_by { |row| row[:number] }
end

def parse_adrs
  text = read_utf8(File.join(ROOT, "docs", "design-v0.1", "DECISIONS.md"))
  rows = []
  current = nil
  text.each_line(chomp: true) do |line|
    if (match = line.match(/\A### (ADR-\d+) — (.+)\z/))
      current = {id: match[1], title: match[2].strip, status: nil}
      rows << current
    elsif current && (match = line.match(/\A\*\*Status:\*\*\s*(.+?)\.?\s*\z/))
      current[:status] ||= match[1].strip
    end
  end
  rows
end

def parse_phases
  text = read_utf8(File.join(ROOT, "docs", "PRODUCT_EXECUTION_ROADMAP.md"))
  rows = []
  text.each_line do |line|
    cells = line.strip
    next unless cells.start_with?("|")

    parts = cells.split("|").map(&:strip)
    parts.shift if parts.first == ""
    parts.pop if parts.last == ""
    next unless parts.length == 6
    next unless parts[0].match?(/\A(P\d+|DR-\d+)\z/)

    rows << {phase: parts[0], capability: parts[1], exit_criterion: parts[5]}
  end
  rows
end

# The product objectives: the roadmap's own definition of "finalize Tamoz"
# (§6). These are the OUTCOME rows — what the product must do — as distinct
# from the phase rows, which are how it got there.
def parse_objectives
  text = read_utf8(File.join(ROOT, "docs", "PRODUCT_EXECUTION_ROADMAP.md"))
  section = text[/^## 6\..*?(?=^## |\z)/m]
  raise EvidenceError, "roadmap §6 not found" unless section

  bullets = []
  section.each_line(chomp: true) do |line|
    if line.start_with?("- ")
      bullets << line.delete_prefix("- ").strip
    elsif !bullets.empty? && line.start_with?("  ") && !line.strip.empty?
      bullets[-1] = "#{bullets.last} #{line.strip}"
    end
  end
  bullets.map { |bullet| bullet.delete_suffix(";").delete_suffix(".") }
end

def parse_public_api
  JSON.parse(read_utf8(File.join(ROOT, "docs", "public-api.json"))).fetch("packages")
end

def parse_cli_subcommands
  source = read_utf8(
    File.join(ROOT, "gems", "tamoz-agent-cli", "lib", "tamoz", "agent", "cli.rb")
  )
  match = source.match(/SUBCOMMAND_HANDLERS\s*=\s*\{(.*?)\}/m)
  raise EvidenceError, "SUBCOMMAND_HANDLERS not found in cli.rb" unless match

  # follow_up/followup are aliases of follow-up; the verb is one requirement.
  aliases = {"follow_up" => "follow-up", "followup" => "follow-up"}
  match[1].scan(/"([^"]+)"\s*=>/).flatten.map { |name| aliases.fetch(name, name) }.uniq
end

def parse_migrations
  source = read_utf8(
    File.join(ROOT, "gems", "tamoz-sqlite", "lib", "tamoz", "sqlite", "migrator.rb")
  )
  # MIGRATION_13 is a %w[] literal (T8.3) — both literal styles count.
  source.scan(/^\s*MIGRATION_(\d+)\s*=\s*(?:\[|%w\[)/).flatten.map(&:to_i).sort.uniq
end

NON_GOALS = [
  ["NG-plugin-api", "No plugin API, marketplace, or caller-supplied capability source",
   "docs/design-v0.1/DECISIONS.md ADR-014; docs/P18_CAPABILITY_HOST_PLAN.md §1"],
  ["NG-arbitrary-shell", "No arbitrary shell: only operator-configured named checks run",
   "docs/PRODUCT_EXECUTION_ROADMAP.md §1; docs/P15_RELEASE_PLAN.md scope"],
  ["NG-real-actuator", "No real physical actuator; the simulator is the only effector",
   "docs/P14_STREAM_PLAN.md owner constraint; INVARIANTS.md 50/51"],
  ["NG-content-authority", "Content (skill/catalog/MCP/memory/model output) never grants authority",
   "docs/design-v0.1/INVARIANTS.md 35, 42"],
  ["NG-self-promotion", "No self-promotion, self-reset, or self-approval of behavior/rules",
   "docs/design-v0.1/INVARIANTS.md 28, 34; ADR-023"],
  ["NG-second-ui", "No second UI and no dashboard; one CLI surface",
   "docs/PRODUCT_EXECUTION_ROADMAP.md §1", false]
].freeze

# --- evidence validation -----------------------------------------------------

def test_case_defined?(file, case_name)
  path = File.join(ROOT, file)
  return false unless File.file?(path)

  read_utf8(path).include?("def #{case_name}")
end

def validate_reference!(reference, requirement_id)
  file, _separator, case_name = reference.partition("#")
  if case_name.empty?
    raise EvidenceError, "#{requirement_id}: evidence #{reference.inspect} must be file#case"
  end
  unless File.file?(File.join(ROOT, file))
    raise EvidenceError, "#{requirement_id}: named test file #{file} does not exist"
  end
  unless test_case_defined?(file, case_name)
    raise EvidenceError,
          "#{requirement_id}: #{file} does not define #{case_name} — evidence " \
          "cannot name a test that does not exist"
  end
  reference
end

def evidence_for(id, default_test: nil)
  entry = EVIDENCE[id] || (default_test ? {test: default_test} : nil)
  named = entry && entry[:test]
  supporting = (entry && entry[:supporting]) || []
  validate_reference!(named, id) if named
  supporting.each { |reference| validate_reference!(reference, id) }

  classification =
    (entry && entry[:classification]) || (named ? "direct" : "missing")
  unless classification == "missing" || CLASSIFICATIONS.include?(classification)
    raise EvidenceError, "#{id}: unknown classification #{classification.inspect}"
  end
  if classification == "indirect" && !(entry && entry[:rationale])
    raise EvidenceError, "#{id}: an indirect row must state why direct proof is unavailable"
  end
  if classification == "pending-owner-residual" && !(entry && entry[:rationale])
    raise EvidenceError, "#{id}: a pending-owner-residual row must state the exact gap"
  end

  {
    "named_test" => named,
    "supporting_tests" => supporting,
    "classification" => classification,
    "rationale" => entry && entry[:rationale],
    "promotion_exclusion" => PROMOTION_EXCLUSIONS[id]
  }
end

def row(id:, source:, title:, category:, release_blocking:, default_test: nil, extra: {})
  evidence = evidence_for(id, default_test:)
  # A release-blocking row with no evidence is allowed — the phase is not
  # finished — but it must NAME the work that will close it. A bare `missing`
  # on a blocking row is how a release audit quietly loses a requirement.
  if release_blocking && evidence.fetch("classification") == "missing" &&
     evidence["rationale"].nil?
    raise EvidenceError,
          "#{id}: a release-blocking row without evidence must state which work " \
          "package closes it"
  end
  {
    "id" => id,
    "category" => category,
    "source" => source,
    "title" => title,
    "release_blocking" => release_blocking,
    # The manifest NEVER claims a pass. The audit computes status by running
    # the named tests (plan §3, correction 2).
    "status" => "unverified"
  }.merge(evidence).merge(extra)
end

# --- build -------------------------------------------------------------------

requirements = []

parse_invariants.each do |invariant|
  number = invariant[:number]
  next if RETIRED_STREAM_CLAUSES.include?(number)

  id = format("INV-%02d", number)
  conditional_package = CONDITIONAL.find { |_name, list| list.include?(number) }&.first
  release_blocking =
    if DEFERRED_V0_2.include?(number) || DEFERRED_V0_3.include?(number)
      false
    elsif conditional_package
      PROMOTED_PACKAGES.include?(conditional_package)
    else
      true
    end
  extra = {}
  extra["conditional_package"] = conditional_package if conditional_package
  extra["deferred_to"] = "v0.2" if DEFERRED_V0_2.include?(number)
  extra["deferred_to"] = "v0.3" if DEFERRED_V0_3.include?(number)
  requirements << row(
    id:,
    source: "docs/design-v0.1/INVARIANTS.md",
    title: invariant[:title],
    category: "invariant",
    release_blocking:,
    extra:
  )
end

parse_adrs.each do |adr|
  policy_only = POLICY_ONLY_ADRS[adr[:id]]
  extra = {"adr_status" => adr[:status]}
  extra["not_release_blocking_because"] = policy_only if policy_only
  requirements << row(
    id: adr[:id],
    source: "docs/design-v0.1/DECISIONS.md",
    title: adr[:title],
    category: "adr",
    release_blocking: policy_only.nil?,
    extra:
  )
end

parse_phases.each do |phase|
  id = "PHASE-#{phase[:phase]}"
  # P15 is this phase; its exit criterion is the audit itself, not a row that
  # can cite a test written before it exists.
  next if phase[:phase] == "P15"

  requirements << row(
    id:,
    source: "docs/PRODUCT_EXECUTION_ROADMAP.md §2",
    title: "#{phase[:capability]} — #{phase[:exit_criterion]}",
    category: "phase_exit_criterion",
    release_blocking: true,
    default_test: PHASE_EVIDENCE[id]
  )
end

parse_objectives.each_with_index do |objective, index|
  id = "OBJ-#{index + 1}"
  requirements << row(
    id:,
    source: "docs/PRODUCT_EXECUTION_ROADMAP.md §6",
    title: objective,
    category: "objective",
    # OBJ-1 aggregates the phase rows and has no behaviour of its own.
    release_blocking: id != "OBJ-1"
  )
end

parse_public_api.each do |package, entries|
  entries.each_key do |entry|
    requirements << row(
      id: "API-#{package}-#{entry}",
      source: "docs/public-api.json",
      title: entry,
      category: "public_api",
      release_blocking: true,
      default_test: PUBLIC_API_EVIDENCE,
      extra: {"package" => package}
    )
  end
end

parse_cli_subcommands.each do |name|
  requirements << row(
    id: "CLI-#{name}",
    source: "gems/tamoz-agent-cli/lib/tamoz/agent/cli.rb SUBCOMMANDS",
    title: "tamoz #{name}",
    category: "cli_command",
    release_blocking: true
  )
end

parse_migrations.each do |ordinal|
  requirements << row(
    id: "MIG-#{ordinal}",
    source: "gems/tamoz-sqlite/lib/tamoz/sqlite/migrator.rb",
    title: "MIGRATION_#{ordinal}",
    category: "migration",
    release_blocking: true
  )
end

NON_GOALS.each do |id, title, source, release_blocking|
  requirements << row(
    id:,
    source:,
    title:,
    category: "non_goal",
    release_blocking: release_blocking.nil? ? true : release_blocking
  )
end

# Every curated evidence id must correspond to a generated row: a stale entry
# (a requirement that no longer exists) is a manifest defect, not a comment.
generated_ids = requirements.map { |requirement| requirement.fetch("id") }.to_set
stale = EVIDENCE.keys.reject { |id| generated_ids.include?(id) }
unless stale.empty?
  raise EvidenceError, "evidence table names requirements that no longer exist: #{stale.join(", ")}"
end

document = {
  "format_version" => 1,
  "generated_by" => "script/generate_requirements_manifest",
  "status_vocabulary" => %w[
    pass missing indirect deferred-by-contract owner-signed-residual
  ],
  "classification_vocabulary" => CLASSIFICATIONS,
  "promotion_matrix" => {
    "promoted_packages" => PROMOTED_PACKAGES,
    "conditional_clauses" => CONDITIONAL.transform_values { |list| list.map { |n| format("INV-%02d", n) } },
    "deferred_v0_2" => DEFERRED_V0_2.map { |n| format("INV-%02d", n) },
    "deferred_v0_3" => DEFERRED_V0_3.map { |n| format("INV-%02d", n) },
    "exclusions" => PROMOTION_EXCLUSIONS
  },
  "requirements" => requirements.sort_by { |requirement| requirement.fetch("id") }
}

content = "#{JSON.pretty_generate(document)}\n"

accepted = ARGV.include?("--accept") || ENV["P15_MANIFEST_ACCEPT"] == "1"
if File.exist?(MANIFEST_PATH) && read_utf8(MANIFEST_PATH) != content && !accepted
  raise ManifestMismatchError,
        "regenerated requirements manifest diverges from the committed file; " \
        "re-run with --accept after reconciling"
end

File.write(MANIFEST_PATH, content)
puts "wrote #{MANIFEST_PATH} (#{requirements.length} requirements)"
counts = requirements.group_by { |requirement| requirement.fetch("classification") }
counts.sort.each { |name, rows| puts "  #{name}: #{rows.length}" }
blocking_without_direct = requirements.count do |requirement|
  requirement.fetch("release_blocking") && requirement.fetch("classification") != "direct"
end
puts "  release-blocking rows without direct evidence: #{blocking_without_direct}"
