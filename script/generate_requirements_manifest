#!/usr/bin/env ruby
# frozen_string_literal: true

# P15-A (docs/P15_RELEASE_PLAN.md §3, correction 1) — the requirements manifest
# generator.
#
# The manifest is the MACHINE-READABLE basis of release status. It is built
# FIRST, from the authoritative sources, so a row cannot drift from the document
# that defines it:
#
#   invariants   docs/design-v0.1/INVARIANTS.md         (all 61 clauses)
#   ADRs         docs/design-v0.1/DECISIONS.md          (accepted ADRs only)
#   phases       docs/PRODUCT_EXECUTION_ROADMAP.md §2   (exit criteria)
#   public API   docs/public-api.json                   (every documented entry)
#   CLI          gems/tamoz-agent/.../cli.rb            (SUBCOMMANDS)
#   migrations   gems/tamoz-sqlite/.../migrator.rb      (MIGRATION_n)
#   non-goals    the binding product non-goals (curated, each with its source)
#
# The EVIDENCE table below is the ONLY hand-authored input: it names the DIRECT
# evidence for a requirement. It is validated at generation time — a named test
# file that does not exist, or a case name that is not defined in that file,
# aborts the generator. A requirement can therefore never cite evidence that
# does not exist.
#
# The manifest NEVER records a passing status. Every row is written with
# `status: "unverified"`; `script/generate_requirements_audit` computes the real
# status by RUNNING the named tests and mapping exit -> status (P15-A
# correction 2). Hand-marking an unsupported row as passing is impossible by
# construction.
#
# Regenerable: running this script verifies the committed manifest against a
# fresh build and raises ManifestMismatchError on divergence; `--accept`
# writes the regenerated manifest.

require "json"
require "set"
require "time"

ROOT = File.expand_path("..", __dir__)
MANIFEST_PATH = File.join(ROOT, "docs", "requirements-manifest.json")

class ManifestMismatchError < StandardError; end
class EvidenceError < StandardError; end

# --- the status/classification vocabulary (plan §3, correction 2) ------------

# `direct`                  a named test proves the requirement; the audit runs it.
# `deferred-by-contract`    the invariants themselves assign the clause to v0.2/v0.3.
# `pending-owner-residual`  a known gap that needs an explicit owner decision at
#                           P15-I. It is NEVER a pass and never silently becomes
#                           `owner-signed-residual` — only a recorded owner
#                           decision can do that.
# `indirect`                no direct proof is available; allowed only for
#                           non-release-blocking rows and must state why.
CLASSIFICATIONS = %w[direct deferred-by-contract pending-owner-residual indirect].freeze

# The invariant clauses the invariants document itself defers (INVARIANTS.md
# preamble). Enumerated, never free-form (plan §3, correction 2).
DEFERRED_V0_2 = [29, 30, 31, 41, 42, 43].freeze
DEFERRED_V0_3 = [28, 32, 33, 34].freeze
# Conditional conformance: release-blocking when the optional package ships.
CONDITIONAL = {
  "tamoz-mcp" => [35, 36, 37],
  "tamoz-scheduler" => [38, 39, 40],
  "tamoz-stream" => [44, 45, 46, 47, 48, 49, 50, 51]
}.freeze
# The P14 streaming-input engine is retired (T8.3); its invariant clauses are
# no longer generated as manifest requirements (INVARIANTS.md keeps them).
RETIRED_STREAM_CLAUSES = [44, 45, 46, 47, 48, 49, 50, 51].freeze
# The promotion matrix (plan §3, correction 3), arbitrated here at P15-A.
# Each optional package that SHIPS as a gem in the release surface is promoted,
# so its conditional clauses are release-blocking. A feature that does not ship
# never pretends to pass its clauses — it is named in `promotion_exclusions`.
PROMOTED_PACKAGES = %w[tamoz-mcp tamoz-scheduler tamoz-stream].freeze

# ADRs that decide a REVIEW POLICY or a DEFERRED PACKAGE rather than shipped
# runtime behavior. They stay in the manifest with their reason recorded, but
# they cannot block a release of the packages that do ship: there is no runtime
# behavior to prove. Every other ADR is release-blocking.
POLICY_ONLY_ADRS = {
  "ADR-004" => "The ADR itself defers `tamoz-chain`; `Tamoz.seq`/`Tamoz.step` are " \
               "not in the release surface (no chain gem exists), so the decision " \
               "governs no shipped behavior.",
  "ADR-013" => "A vocabulary/review policy with no runtime behavior. The pinned " \
               "public inventory is the enforcing artifact.",
  "ADR-034" => "The tree-digest identity half ships and is directly evidenced; the " \
               "supply-chain activation half is invariant 43, which the invariants " \
               "document defers to v0.2 (no install path exists in v0.1)."
}.freeze

# Named, bounded exclusions from the v0.1 release surface. Each names the exact
# unavailable behavior so the clause is not claimed. These become the owner's
# P15-I decision list.
PROMOTION_EXCLUSIONS = {
  "INV-39" => "Cron/IANA civil-time scheduling is not implemented " \
              "(docs/P13_SCHEDULER_PLAN.md §12 deferral); the shipped surface is " \
              "at/interval only. The misfire/overlap/backlog/jitter half of the " \
              "clause has direct evidence; the civil-time half is unavailable.",
  "INV-43" => "Skill install/update/self-improvement staging is not implemented " \
              "(P9-C/D2/E deferred); the shipped surface is operator-configured " \
              "catalogs only. No install path exists to claim or fail this clause."
}.freeze

