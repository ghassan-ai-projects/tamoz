{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tamoz evals runner split baseline receipt",
  "type": "object",
  "required": ["schema_version", "source", "artifacts", "cases", "public_api", "load_graph", "intentional_changes", "manifest_failure_cases"],
  "properties": {
    "schema_version": {"const": "phase-2-baseline-v1"},
    "source": {
      "type": "object",
      "required": ["git_revision", "gem_digests", "lockfile_digest"],
      "properties": {
        "git_revision": {"type": "string", "minLength": 1},
        "gem_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "lockfile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "argv", "stdout_b64", "stderr_b64", "exit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "items": {"type": "string"}},
          "stdout_b64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
          "stderr_b64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
          "exit": {"type": "integer", "minimum": 0, "maximum": 255},
          "side_effects": {"type": "array", "items": {"type": "string"}},
          "decision": {"type": ["string", "null"]},
          "exception_class": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "public_api": {
      "type": "object",
      "required": ["requires", "constants"],
      "properties": {
        "requires": {"type": "array", "items": {"type": "string"}},
        "constants": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "load_graph": {
      "type": "object",
      "required": ["base", "runner"],
      "properties": {
        "base": {"type": "array", "items": {"type": "string"}},
        "runner": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "intentional_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "before", "after", "reason"],
        "properties": {
          "surface": {"type": "string"},
          "before": {"type": "string"},
          "after": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "manifest_failure_cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"const": {"name":"missing","exit":3,"stdout_b64":"","stderr_b64":"cnVubmVyIGlucHV0IG1hbmlmZXN0IGlzIHJlcXVpcmVkCg==","side_effects":[]}},
          {"const": {"name":"malformed","exit":64,"stdout_b64":"","stderr_b64":"cnVubmVyIGlucHV0IG1hbmlmZXN0IGlzIGludmFsaWQK","side_effects":[]}},
          {"const": {"name":"incomplete","exit":64,"stdout_b64":"","stderr_b64":"cnVubmVyIGlucHV0IG1hbmlmZXN0IGlzIGluY29tcGxldGUK","side_effects":[]}},
          {"const": {"name":"repository_relative","exit":64,"stdout_b64":"","stderr_b64":"cnVubmVyIGlucHV0IHBhdGhzIG11c3QgYmUgZXhwbGljaXQgYW5kIGV4dGVybmFsCg==","side_effects":[]}},
          {"const": {"name":"missing_openclaw_factory","exit":3,"stdout_b64":"","stderr_b64":"b3BlbmNsYXcgYmVuY2htYXJrIHJlcXVpcmVzIGFuIGV4dGVybmFsIGZpeHR1cmUgZmFjdG9yeQo=","side_effects":[]}}
        ]
      }
    }
  },
  "additionalProperties": false
}
