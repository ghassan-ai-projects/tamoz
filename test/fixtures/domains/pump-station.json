    },
    {
      "code": "bearing_wear",
      "description": "radial vibration rising against the pump's own baseline"
    },
    {
      "code": "misalignment",
      "description": "axial vibration rising against the pump's own baseline"
    },
    {
      "code": "overload",
      "description": "current and temperature above the duty point"
    },
    {
      "code": "lubrication_due",
      "description": "slow exponential vibration creep from a missed lubrication"
    },
    {
      "code": "sensor_drift",
      "description": "the vibration probe reads high while the pump is healthy"
    },
    {
      "code": "sensor_failure",
      "description": "the vibration probe pins high and stops moving"
    },
    {
      "code": "transient_none",
      "description": "a transient that settles on its own, such as cavitation"
    }
