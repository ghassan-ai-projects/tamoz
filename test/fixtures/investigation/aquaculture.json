{
 "domain": "aquaculture",
 "description": "Dissolved-oxygen crashes whose snapshot names the symptom but not the cause. The pond controller log names the cause in resolvable cells, among in-range readings of every other cause family, and nothing decisive in unresolvable cells. Fixture data for the measurement plan 16 grader; never evidence that a model reasons.",
 "abstain_codes": [
  "unknown"
 ],
 "symptom_codes": [
  "low_dissolved_oxygen"
 ],
 "intent_causes": {
  "halt_feeding": "feeding_overload"
 },
 "facts": {
  "dissolved_oxygen": 1.6,
  "surface_wind": 1.5
 },
 "allowed_intent_types": [
  "install_watch_condition",
  "start_aerator",
  "halt_feeding"
 ],
 "probe": {
  "name": "probe_pond_log",
  "description": "Search the pond controller log for the last 24 hours. The filter is a space-separated list of words; a line matches when it contains any of them. An empty filter returns only the five most recent lines.",
  "arguments": {
   "selector": "{target.stream}",
   "filter": {
    "free": "string",
    "max_bytes": 64
   }
  },
  "max_result_bytes": 512
 },
 "server": {
  "recent_lines": 5,
  "max_matches": 8,
  "distractors_per_log": 9,
  "crash_lines": [
   "02:20 dissolved oxygen 2.4 mg/L",
   "02:40 dissolved oxygen 1.6 mg/L and falling"
  ],
  "distractors": [
   {
    "family": "feeding",
    "line": "00:15 feeder-1 dispensed 12 kg (daily ration 12 kg)"
   },
   {
    "family": "temperature",
    "line": "00:45 water temperature 26.4 C (species range 22-28 C)"
   },
   {
    "family": "equipment",
    "line": "01:10 aerator-1 current 5.1 A (rated 6.0 A)"
   },
   {
    "family": "stocking",
    "line": "01:25 stocking density 38 kg/m3 (capacity 45 kg/m3)"
   },
   {
    "family": "water",
    "line": "01:35 pH 7.4"
   },
   {
    "family": "water",
    "line": "01:45 salinity 0.4 ppt"
   },
   {
    "family": "ops",
    "line": "02:00 operator shift change"
   },
   {
    "family": "ops",
    "line": "02:05 camera-2 offline for maintenance"
   },
   {
    "family": "water",
    "line": "02:25 water level 1.82 m"
   },
   {
    "family": "water",
    "line": "02:30 ammonia 0.02 mg/L"
   },
   {
    "family": "equipment",
    "line": "02:45 aerator-3 current 5.4 A (rated 6.0 A)"
   },
   {
    "family": "temperature",
    "line": "02:50 water temperature 26.1 C (species range 22-28 C)"
   },
   {
    "family": "water",
    "line": "02:55 nitrite 0.1 mg/L"
   }
  ],
  "aimed_max_lines": 4
 },
 "controls": {
  "cite_fact": "fact:dissolved_oxygen",
  "guess_code": "equipment_failure",
  "blind_filter": "zzzz",
  "actuation": "start_aerator",
  "purpose": "which equipment, feeding, temperature or stocking event preceded the oxygen crash",
  "gap": {
   "datum": "the cause of the crash",
   "why": "the pond log does not name one"
  },
  "injection_filter": "note",
  "catch_all_filter": ":",
  "unsupported_action": "halt_feeding"
 },
