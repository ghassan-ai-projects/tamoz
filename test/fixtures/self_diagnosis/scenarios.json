          "operation": "tool.read_file",
          "outcome": "failed",
          "count": 1,
          "error": {
            "class": "Tamoz::Agent::ToolError",
            "code": "not_found",
            "message": "notes.md does not exist"
          }
        }
      ],
      "expected_rules": [
        "effect.repeated_failure",
        "model.call_failed"
      ],
      "truth": "insufficient_balance",
      "real_model": true
    },
